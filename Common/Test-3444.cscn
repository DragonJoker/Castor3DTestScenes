			pos 20.0 10.0 20.0
			pos  0.0 20.0  0.0
			pos  0.0 20.0 10.0
			pos  0.0 20.0 20.0
			pos 10.0 20.0  0.0
			pos 10.0 20.0 10.0
			pos 10.0 20.0 20.0
			pos 20.0 20.0  0.0
			pos 20.0 20.0 10.0
			pos 20.0 20.0 20.0
		}
	}

	scene_node "Billboard"
	{
		scale 10 10 10
	}
	billboard "Billboard"
	{
		parent "Billboard"
		type spherical
		material "Billboard"
		dimensions 200 200
		positions
		{
			pos 80.0 40.0 -40.0
		}
	}

	/**
	*	PARTICLES
	*/

	material "Fireworks"
	{
		pass
		{
			diffuse 1 0 0
			specular 0 0 0
			emissive 1.0
			shininess 50
			mixed_interpolation true

			texture_unit
			{
				image "Textures/fireworks_red.png"
				channel opacity
				sampler	"Default"
			}
		}
	}
	scene_node "Fireworks"
	{
		position 400 0 0
	}
	particle_system "Fireworks"
	{
		parent "Fireworks"
		particles_count 10000
		dimensions 20 20
		material "Fireworks"
		particle
		{
			type "fireworks"
			variable "position" vec3f 0 0 0
			variable "type" float 0
			variable "velocity" vec3f 0 0.01 0
			variable "age" float 0
		}
	}

