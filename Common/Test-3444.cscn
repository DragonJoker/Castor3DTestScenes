		animated_object "HellKnight4"

		animation "attack2"
		{
			looped true
			scale -1
		}

		start_animation "attack2"
	}

	/**
	*	BILLBOARDS
	*/

	material "Billboards"
	{
		pass
		{
			diffuse 0.5 0.5 0.5 1.0
			emissive 0.0 0.0 0.0 1.0
			specular 1.0 1.0 1.0 1.0
			shininess 50.0
			mixed_interpolation true

			texture_unit
			{
				channel diffuse
				image "Textures/Billboards/AlphaRejection.png" rgb
				sampler	"Default"
			}

			texture_unit
			{
				channel opacity
				image "Textures/Billboards/AlphaRejection.png" a
				sampler	"Default"
			}
		}
	}

	material "Billboard"
	{
		pass
		{
			diffuse 0.5 0.5 0.5 1.0
			emissive 0.0 0.0 0.0 1.0
			specular 1.0 1.0 1.0 1.0
			shininess 50.0
			two_sided true

			texture_unit
			{
				image "Textures/Bricks/Diffuse.jpg"
				channel diffuse
				sampler	"Default"
			}
		}
	}

	scene_node "Billboards"
	{
		scale 10 10 10
	}
	billboard "Billboards"
	{
		parent "Billboards"
		type cylindrical
		material "Billboards"
		dimensions 50 50
		positions
		{
			pos  0.0  0.0  0.0
			pos  0.0  0.0 10.0
			pos  0.0  0.0 20.0
			pos 10.0  0.0  0.0
			pos 10.0  0.0 10.0
