		type directional
		colour 1.0 1.0 1.0
		intensity 0.8 1.0
	}

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 135
		position -336 79 532
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}

