materials pbr

scene "Scene"
{
	ambient_light 1.0 1.0 1.0

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	// Textures

	texture "BricksDif"
	{
		image "Textures/Bricks/Diffuse.jpg"
		albedo_mask 0x00FFFFFF
	}

	texture "BricksNml"
	{
		image "Textures/Bricks/Normal.jpg"
		normal_mask 0x00FFFFFF
	}

	texture "BricksRgh"
	{
		image "Textures/Bricks/Height.jpg"
		roughness_mask 0x00FF0000
	}

	texture "WaterNormal1"
	{
		image "Textures/Waves/waterNM1.dds"
		water_normal1_mask 0x00FFFFFF
	}

	texture "WaterNormal2"
	{
		image "Textures/Waves/waterNM2.dds"
		water_normal2_mask 0x00FFFFFF
	}

	texture "WaterNoise"
	{
		image "Textures/Waves/waterNoise.dds"
		water_noise_mask 0x00FF0000
	}

	//Samplers

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	// Materials

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metalness 0.0
			roughness 0.8

			texture_unit
			{
				texture "BricksDif"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksNml"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksRgh"
				sampler "Linear"
			}
		}
	}

	material "WaterMaterial"
	{
		pass
		{
			colour_srgb 0.003 0.599 0.812
			metalness 0.0
			roughness 0.08
			refraction_ratio 1.2
			dampeningFactor 5.0
			depthSofteningDistance 0.5
			refractionDistortionFactor 0.04
			refractionHeightFactor 2.5
			refractionDistanceFactor 0.05
			ssrStepSize 0.5
			ssrForwardStepsCount 20.0
			ssrBackwardStepsCount 10.0
			ssrDepthMult 20.0

			texture_unit
			{
				texture "WaterNormal1"
				sampler "Linear"
				animation
				{
					translate 0.01 0.0
				}
			}

			texture_unit
			{
				texture "WaterNormal2"
				sampler "Linear"
				animation
				{
					translate 0.0 0.01
				}
			}

			texture_unit
			{
				texture "WaterNoise"
				sampler "Linear"
			}
		}
	}

	// Meshes

	mesh "FloorMesh"
	{
		type "plane" -width_subdiv=0 -depth_subdiv=0 -width=600 -depth=600
		default_material "FloorMaterial"
	}

	mesh "WaterMesh"
	{
		type "plane" -width_subdiv=1000 -depth_subdiv=1000 -width=1000 -depth=1000
		default_material "WaterMaterial"
	}

	// SceneNodes

	scene_node "FloorNode"
	{
		position 0.0 0.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}

	scene_node "WaterNode"
	{
		position 0.0 2.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}

	scene_node "LightNode"
	{
		orientation 0.497314 0.68907 -0.527125 210.623
	}

	scene_node "MainCameraNode"
	{
		position -439.625 139.968 -507.437
		orientation 0.501137 0.847037 -0.177171 45.3094
	}

	// Geometries

	object "Floor"
	{
		parent "FloorNode"
		mesh "FloorMesh"
	}

	object "Water"
	{
		parent "WaterNode"
		mesh "WaterMesh"
	}

	// Lights

	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		intensity 8.0 10.0
	}

	// Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}
}

window "Window"
{
	fullscreen false
	vsync false

	render_target
	{
		format argb32
		size 800 600
		scene "Scene"
		camera "MainCamera"
	}
}
