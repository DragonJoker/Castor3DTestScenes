material "PBRHead"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 1.00000 1.00000 1.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.804688
		transmittance 1.0

		texture_unit
		{
			sampler "Trilinear"
			texture "Head-NormalHeight"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Head-Diffuse"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Head-MetallicRoughness"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Head-Transmittance"
		}

		subsurface_scattering
		{
			strength 1
			gaussian_width gaussianWidth
			thickness_scale thicknessScale

			transmittance_profile
			{
				factor 0.233 0.455 0.649 0.0064
				factor 0.1 0.336 0.344 0.0484
				factor 0.118 0.198 0.0 0.187
				factor 0.113 0.007 0.007 0.567
				factor 0.358 0.004 0.0 1.99
				factor 0.078 0.0 0.0 7.41
			}
		}
	}
}

