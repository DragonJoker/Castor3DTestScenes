// Samplers

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode clamp_to_border
	v_wrap_mode clamp_to_border
	w_wrap_mode clamp_to_border
	min_lod 0.00000
	max_lod 5.00000
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 5.00000
}

// Materials

material "PBRBody"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 1.00000 1.00000 1.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.804688
		alpha_func greater 0.500000

		texture_unit
		{
			sampler "Trilinear"
			image "Textures/Nyras/body-normaldispl.dds"
			height_mask 0xff000000
			height_factor 0.100000
			normal_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 11
			image "Textures/Nyras/body-opacitymetallic.dds"
			opacity_mask 0x00ff0000
			metalness_mask 0x0000ff00
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 11
			image "Textures/Nyras/body-diffuse.dds"
			colour_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 11
			image "Textures/Nyras/body-roughness.dds"
			roughness_mask 0x00ff0000
			invert_y true
		}
	}
}

material "PBRCornea"
{

	pass
	{
		lighting_model c3d.pbr
		alpha_blend_mode interpolative
		two_sided true
		opacity 0.119661
		bw_accumulation 1
		colour_hdr 0.00000 0.00000 0.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.00000
	}
}

