define thicknessScale 10
define gaussianWidth 1

// Samplers

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode clamp_to_border
	v_wrap_mode clamp_to_border
	w_wrap_mode clamp_to_border
	min_lod 0.00000
	max_lod 5.00000
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 5.00000
}

// Materials

material "PBRBody"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 1.00000 1.00000 1.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.804688
		alpha_func greater 0.500000

		texture_unit
		{
			sampler "Trilinear"
			texture "Body-NormalHeight"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Body-OpacityMetalness"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Body-Diffuse"
		}

		texture_unit
		{
			sampler "Trilinear"
			texture "Body-Roughness"
		}
	}
}

material "PBRCornea"
{

	pass
	{
		lighting_model c3d.pbr
		alpha_blend_mode interpolative
		two_sided true
		opacity 0.119661
		bw_accumulation 1
		colour_hdr 0.00000 0.00000 0.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.00000
	}
}

