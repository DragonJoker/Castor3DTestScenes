material "PBRHead"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 1.00000 1.00000 1.00000
		specular 1.00000 1.00000 1.00000
		metalness 1.00000
		roughness 0.804688

		texture_unit
		{
			sampler "Trilinear"
			image "Textures/Nyras/head-normaldispl.dds"
			height_mask 0xff000000
			height_factor 0.100000
			normal_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 10
			image "Textures/Nyras/head-diffuse.dds"
			colour_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 10
			image "Textures/Nyras/head-metallicroughness.dds"
			metalness_mask 0x00ff0000
			roughness_mask 0x0000ff00
			invert_y true
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 10
			image "Textures/Nyras/head-transmittance.png"
			transmittance_mask 0xff000000
		}

		subsurface_scattering
		{
			strength 1
			gaussian_width 20

			transmittance_profile
			{
				factor 0.233 0.455 0.649 0.0064
				factor 0.1 0.336 0.344 0.0484
				factor 0.118 0.198 0.0 0.187
				factor 0.113 0.007 0.007 0.567
				factor 0.358 0.004 0.0 1.99
				factor 0.078 0.0 0.0 7.41
			}
		}
	}
}

