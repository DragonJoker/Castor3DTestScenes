// Samplers

sampler "Default"
{
	min_filter linear
	mag_filter linear
	mip_filter nearest
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "BlueTransWithMask"
{

	pass
	{
		two_sided true
		colour_hdr 0.0865004 0.462077 0.846874
		transmission 1.00000
		roughness 0.00000
		alpha_func greater 0.950000
		blend_alpha_func less_equal 0.950000

		texture_unit
		{
			texture "Image_texture214190_texture214190"
		}

		texture_unit
		{
			texture "Image_texture14184_texture14184"
		}
	}
}

