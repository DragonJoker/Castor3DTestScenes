material "inventor_accessories"
{

	pass
	{
		diffuse 0.640000 0.406873 0.176735
		specular 0.00000 0.00000 0.00000
		ambient 0.00000
		shininess 9.60784

		texture_unit
		{
			image "Textures/Towers/inventor_tower_tower1_inventor_Normal.dds"
			normal_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			levels_count 9
			image "Textures/Towers/inventor_tower_tower1_inventor_Diffuse.dds"
			diffuse_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			levels_count 9
			image "Textures/Towers/inventor_tower_tower1_inventor_SpecularGloss.dds"
			specular_mask 0x00ffffff
			shininess_mask 0xff000000
			invert_y true
		}
	}
}

