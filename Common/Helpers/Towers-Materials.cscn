// Samplers

sampler "Default"
{
	min_filter linear
	mag_filter linear
	mip_filter nearest
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "Imp-Material"
{

	pass
	{
		diffuse 0.640000 0.640000 0.640000
		specular 1.00000 1.00000 1.00000
		ambient 1.00000
		shininess 50.0000
		alpha 0.00000
		bw_accumulation 1
	}
}

