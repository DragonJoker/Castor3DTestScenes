// Samplers

sampler "Default"
{
	min_filter linear
	mag_filter linear
	mip_filter nearest
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "FlatBackdrop"
{

	pass
	{
		colour_hdr 1.00000 1.00000 1.00000
		roughness 0.500000

		texture_unit
		{
			levels_count 7
			image "Textures/Attenuation/PlainGrid.dds"
			colour_mask 0x00ffffff
			invert_y true
		}
	}
}

material "LabelMaterial"
{

	pass
	{
		colour_hdr 1.00000 1.00000 1.00000
		roughness 0.800000

		texture_unit
		{
			levels_count 8
			image "Textures/Attenuation/AttenuationLabels.dds"
			colour_mask 0x00ffffff
			invert_y true
		}
	}
}

material "R1_Sample_0.25"
{

	pass
	{
		two_sided true
		colour_hdr 0.562341 0.840896 0.974004
