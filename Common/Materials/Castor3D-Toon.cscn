
// Samplers

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod 0
	max_lod 5
	lod_bias 0
	max_anisotropy 1
}

// Materials

material "Pufi"
{
	pass
	{
		albedo 1.00000 1.00000 1.00000
		specular 0.20000 0.20000 0.20000
		roughness 1.00000
		metalness 0.00000
		two_sided false
		smooth_band_width 4.0
		edge_width 1.0
		edge_normal_factor 1.0

		texture_unit
		{
			sampler "Trilinear"
			levels_count 11
			image "Textures/Pufi/Pufi-BaseColor.exr"
			albedo_mask 0x00ffffff
		}

		texture_unit
		{
			sampler "Trilinear"
			levels_count 11
			image "Textures/Pufi/Pufi-Roughness.exr"
			roughness_mask 0x00ffffff
		}
	}
}
