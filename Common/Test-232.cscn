materials pbr

scene "Scene"
{
	ambient_light 0.2 0.2 0.2
	background_colour 0.5 0.5 0.5 1.0

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metalness 0.0
			roughness 0.0
			two_sided true
			untile true

			texture_unit
			{
				image "Textures/Rock/eroded-layered-rockface_albedo.png"
				albedo_mask 0x00FFFFFF
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Rock/eroded-layered-rockface_normal-ogl.png"
				normal_mask 0x00FFFFFF
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Rock/eroded-layered-rockface_ao.png"
				occlusion_mask 0x00FF0000
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Rock/eroded-layered-rockface_height.png"
				height_mask 0x00FF0000
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Rock/eroded-layered-rockface_roughness.png"
				roughness_mask 0x00FF0000
				sampler	"Linear"
			}
		}
	}

	scene_node "SunLightNode1"
	{
		orientation 1 0 0 45
	}
	light "SunLight1"
	{
		parent "SunLightNode1"
		type directional
		colour 1.0 1.0 1.0
		intensity 0.8 1.0
	}

	scene_node "FinalNode"
	{
		position 0.0 0.0 0.0
		scale 10 10 10
	}
	mesh "Mesh"
	{
		diamond_square_terrain
		{
			detail 10
			heightRange -75.0 75.0
			disableRandomSeed true
			//gradient "Textures/Rock/grad.png"
		}
	}
	object "FinalPrimitive"
	{
		parent "FinalNode"
		mesh "Mesh"
		material "FloorMaterial"
	}

	scene_node "MainCameraNode"
	{
		position -2386.53 3540.84 5085.33
		orientation -0.0299468 -0.946933 0.320032 190.127
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 0.1
			far 20000.0
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 800 600
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
