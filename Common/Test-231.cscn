// Global configuration
materials blinn_phong

scene "MyScene"
{
	// Scene configuration
	ambient_light 0.200000 0.200000 0.200000
	background_colour 0.500000 0.500000 0.500000
	lpv_indirect_attenuation 1.70000
	include "Helpers/Towers-Materials.cscn"
	include "Helpers/Towers-Meshes.cscn"
	include "Helpers/Towers-Nodes.cscn"
	include "Helpers/Towers-Objects.cscn"
	include "Helpers/Towers-Lights.cscn"

	//Voxel Cone Tracing

	voxel_cone_tracing
	{
		enabled false
		grid_size 2
		conservative_rasterization false
		temporal_smoothing false
		occlusion false
		secondary_bounce false
		num_cones 2
		max_distance 20.0000
		ray_step_size 0.750000
		voxel_size 1.00000
	}

	//Cameras nodes

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 180
		position 0.00000 0.00000 1000.00
	}

	//Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"

		viewport
		{
			type perspective
			near 0.100000
			far 20000.0
			aspect_ratio 1.33300
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}

	//Animated object groups

	animated_object_group "HeavySplash"
	{
		animated_object "HeavySplash"

		animation "armature_short_range.1|attack"
		{
			looped true
		}

		start_animation "armature_short_range.1|attack"
	}

	animated_object_group "Inventor"
	{
		animated_object "Inventor"

		animation "armature_inventor.1|Action"
		{
			looped true
		}

		start_animation "armature_inventor.1|Action"
	}

	animated_object_group "ShortRange"
	{
		animated_object "ShortRange"

		animation "armature_short_range.1|attack"
		{
			looped true
		}

		start_animation "armature_short_range.1|attack"
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 800 600
		format rgba32
		tone_mapping "linear"
		scene "MyScene"
		camera "MainCamera"

		ssao
		{
			enabled false
			high_quality false
			use_normals_buffer false
			blur_high_quality false
			intensity 1.00000
			radius 0.500000
			bias 0.0250000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
