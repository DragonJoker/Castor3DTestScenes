materials pbr

scene "Scene"
{
	ambient_light 1.0 1.0 1.0

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	// Textures

	texture "BricksDif"
	{
		image "Textures/Bricks/Diffuse.jpg"
		albedo_mask 0x00FFFFFF
	}

	texture "BricksNml"
	{
		image "Textures/Bricks/Normal.jpg"
		normal_mask 0x00FFFFFF
	}

	texture "BricksRgh"
	{
		image "Textures/Bricks/Height.jpg"
		roughness_mask 0x00FF0000
	}

	texture "WaterNormal1"
	{
		image "Textures/Water/waterNM1.dds"
		water_normal1_mask 0x00FFFFFF
	}

	texture "WaterNormal2"
	{
		image "Textures/Water/waterNM2.dds"
		water_normal2_mask 0x00FFFFFF
	}

	texture "WaterNoise"
	{
		image "Textures/Water/waterNoise.dds"
		water_noise_mask 0x00FF0000
	}

	texture "WaterFoam"
	{
		image "Textures/Water/waterFoam.dds"
		water_foam_mask 0x00FFFFFF
	}

	//Samplers

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	// Materials

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metalness 0.0
			roughness 0.8

			texture_unit
			{
				texture "BricksDif"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksNml"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksRgh"
				sampler "Linear"
			}
		}
	}

	material "OceanMaterial"
	{
		pass
		{
			lighting_model water.pbr
			colour_srgb 0.003 0.599 0.812
			metalness 0.0
			roughness 0.08
			refraction_ratio 1.2
			dampeningFactor 5.0
			depthSofteningDistance 0.5
			refractionDistortionFactor 0.04
			refractionHeightFactor 2.5
			refractionDistanceFactor 0.05
			ssrStepSize 0.5
			ssrForwardStepsCount 20.0
			ssrBackwardStepsCount 10.0
			ssrDepthMult 20.0
			foamNoiseTiling 50.0

			texture_unit
			{
				texture "WaterNormal1"
				sampler "Linear"
				animation
				{
					translate 0.01 0.0
				}
			}

			texture_unit
			{
				texture "WaterNormal2"
				sampler "Linear"
				animation
				{
					translate 0.0 0.01
				}
			}

			texture_unit
			{
				texture "WaterNoise"
				sampler "Linear"
			}

			texture_unit
			{
				texture "WaterFoam"
				sampler "Linear"
			}
		}
	}

	// Meshes

	mesh "FloorMesh"
	{
		type "plane" -width_subdiv=0 -depth_subdiv=0 -width=200 -depth=200
		default_material "FloorMaterial"
	}

	mesh "OceanMesh"
	{
		waves
		{
			widthSubdiv 50
			depthSubdiv 50
			width 250
			depth 250
			tessellationFactor 7
			dampeningFactor 5.0
/*
			wave
			{
				direction 0.3 0.0 -0.7
				steepness 1.79
				length 3.75
				amplitude 0.85
				speed 3.63
			}
			wave
			{
				direction 0.5 0.0 -0.2
				steepness 1.79
				length 4.1
				amplitude 0.52
				speed 3.09
			}
*/
		}
		default_material "OceanMaterial"
	}

	// SceneNodes

	scene_node "FloorNode"
	{
		position 0.0 0.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}

	scene_node "OceanNode"
	{
		position 0.0 2.0 0.0
		//orientation 1.0 0.0 0.0 270.0
	}

	scene_node "LightNode"
	{
		orientation 0.497314 0.68907 -0.527125 210.623
	}

	scene_node "MainCameraNode"
	{
		position -37.2316 3.88 -38.2203
		orientation 0.314755 0.935508 -0.160479 57.1808
	}

	// Geometries

	object "Floor"
	{
		parent "FloorNode"
		mesh "FloorMesh"
	}

	object "Ocean"
	{
		parent "OceanNode"
		mesh "OceanMesh"
	}

	// Lights

	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		intensity 8.0 10.0
	}

	// Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}
}

window "Window"
{
	fullscreen false
	vsync false

	render_target
	{
		format argb32
		size 1920 1080
		scene "Scene"
		camera "MainCamera"
	}
}
