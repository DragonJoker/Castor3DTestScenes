materials pbr

scene "Scene"
{
	ambient_light 1.0 1.0 1.0

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metalness 0.0
			roughness 0.8

			texture_unit
			{
				image "Textures/Bricks/Diffuse.jpg"
				albedo_mask 0x00FFFFFF
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Bricks/Normal.jpg"
				normal_mask 0x00FFFFFF
				sampler	"Linear"
			}

			texture_unit
			{
				image "Textures/Bricks/Height.jpg"
				channel roughness
				sampler	"Linear"
			}
		}
	}
	mesh "FloorMesh"
	{
		type "plane" -width_subdiv=0 -depth_subdiv=0 -width=200 -depth=200
		default_material "FloorMaterial"
	}
	scene_node "FloorNode"
	{
		position 0.0 0.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}
	object "Floor"
	{
		parent "FloorNode"
		mesh "FloorMesh"
	}

	material "OceanMaterial"
	{
		render_pass "c3d.ocean"

		pass
		{
			colour_srgb 0.003 0.599 0.812
			emissive 0.0
			metalness 0.0
			roughness 0.08
		}
	}
	mesh "OceanMesh"
	{
		type "plane" -width_subdiv=50 -depth_subdiv=50 -width=250 -depth=250 -tile_uv -flipYZ
		default_material "OceanMaterial"
	}
	scene_node "OceanNode"
	{
		position 0.0 2.0 0.0
		//orientation 1.0 0.0 0.0 270.0
	}
	object "Ocean"
	{
		parent "OceanNode"
		mesh "OceanMesh"
	}

	scene_node "LightNode"
	{
		orientation 0.497314 0.68907 -0.527125 210.623
	}
	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		intensity 8.0 10.0
	}

	scene_node "MainCameraNode"
	{
		position -37.2316 3.88 -38.2203
		orientation 0.314755 0.935508 -0.160479 57.1808
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}
}

window "Window"
{
	fullscreen false
	vsync false

	render_target
	{
		format argb32
		size 1920 1080
		scene "Scene"
		camera "MainCamera"

		ocean_rendering
		{
			tessellationFactor 7
			dampeningFactor 5.0
			refractionDistortionFactor 0.04
			refractionHeightFactor 0.0005
			refractionDistanceFactor 0.0005
			depthSofteningDistance 0.5
			foamHeightStart 0.8
			foamFadeDistance 0.4
			foamTiling 2.0
			foamAngleExponent 80.0
			foamBrightness 4.0
			normalMapScrollSpeed 0.0001 0.0001
			normalMapScroll 1.0 0.0 0.0 1.0
			ssrStepSize 0.5
			ssrForwardStepsCount 20.0
			ssrBackwardStepsCount 10.0
			ssrDepthMult 20.0
			foam "Textures/Waves/waterFoam.dds"
			normals1 "Textures/Waves/waterNM1.dds"
			normals2 "Textures/Waves/waterNM2.dds"
			noise "Textures/Waves/waterNoise.dds"

			waves
			{
				wave
				{
					direction 0.3 0.0 -0.7
					steepness 1.79
					length 3.75
					amplitude 0.85
					speed 3.63
				}
				wave
				{
					direction 0.5 0.0 -0.2
					steepness 1.79
					length 4.1
					amplitude 0.52
					speed 3.09
				}
			}
		}
	}
}
