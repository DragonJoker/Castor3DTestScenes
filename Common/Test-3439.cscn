materials metallic_roughness

scene "Scene"
{
	ambient_light 1.0 1.0 1.0

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metallic 0.0
			roughness 0.8
		}
	}
	mesh "FloorMesh"
	{
		type "plane" -width_subdiv=0 -depth_subdiv=0 -width=600 -depth=600
		default_material "FloorMaterial"
	}
	scene_node "FloorNode"
	{
		position 0.0 0.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}
	object "Floor"
	{
		parent "FloorNode"
		mesh "FloorMesh"
	}

	material "OceanMaterial"
	{
		waves true

		pass
		{
			albedo 0.465 0.797 0.991
			emissive 0.0
			transmission 0.003 0.599 0.812
			metallic 0.0
			roughness 0.08
		}
	}
	mesh "OceanMesh"
	{
		type "plane" -width_subdiv=50 -depth_subdiv=50 -width=1000 -depth=1000 -tile_uv
		default_material "OceanMaterial"
	}
	scene_node "OceanNode"
	{
		position 0.0 10.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}
	object "Ocean"
	{
		parent "OceanNode"
		mesh "OceanMesh"
	}

	scene_node "LightNode"
	{
		orientation 0.497314 0.68907 -0.527125 210.623
	}
	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		intensity 8.0 10.0
	}

	scene_node "MainCameraNode"
	{
		position -302.572 171.991 -357.361
		orientation -0.36224 -0.904546 0.224896 291.071
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 0.1
			far 20000.0
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 800 600
		scene "Scene"
		camera "MainCamera"

		wave_rendering
		{
			tessellationFactor 7
			dampeningFactor 5.0
			refractionDistortionFactor 0.04
			refractionHeightFactor 2.5
			refractionDistanceFactor 15.0
			depthSofteningDistance 20.0
			foamHeightStart 0.8
			foamFadeDistance 0.4
			foamTiling 2.0
			foamAngleExponent 80.0
			foamBrightness 4.0
			normalMapScrollSpeed 0.01 0.01
			normalMapScroll 1.0 0.0 0.0 1.0
			ssrSettings 0.5 20.0 10.0 20.0
			foam "Textures/Waves/waterFoam.dds"
			normals1 "Textures/Waves/waterNM1.dds"
			normals2 "Textures/Waves/waterNM2.dds"
			noise "Textures/Waves/waterNoise.dds"

			waves
			{
				wave
				{
					direction 0.3 0.0 -0.7
					steepness 1.79
					length 3.75
					amplitude 0.85
					speed 1.21
				}
				wave
				{
					direction 0.5 0.0 -0.2
					steepness 1.79
					length 4.1
					amplitude 0.52
					speed 1.03
				}
			}
		}
	}
	fullscreen false
	vsync false
}
