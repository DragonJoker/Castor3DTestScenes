materials blinn_phong

scene "Scene"
{
	ambient_light 0.2 0.2 0.2

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		min_lod 0.0
		max_lod 0.0
		lod_bias 0.0
		u_wrap_mode clamp_to_edge
		v_wrap_mode clamp_to_edge
		w_wrap_mode clamp_to_edge
		border_colour float_opaque_black
	}

	material "Material"
	{
		pass
		{
			diffuse 0.75164	0.75164	0.75164 1.0
			emissive 0.0 0.0 0.0 1.0
			specular 0.628281 0.628281 0.628281 1.0
			shininess 51.2

			texture_unit
			{
				image "Textures/Bricks/Diffuse.jpg"
				channel diffuse
				sampler	"Linear"
			}
		}
	}

	skybox
	{
		left "Textures/backgroundSkybox_left.tga"
		right "Textures/backgroundSkybox_right.tga"
		top "Textures/backgroundSkybox_top.tga"
		bottom "Textures/backgroundSkybox_bottom.tga"
		front "Textures/backgroundSkybox_front.tga"
		back "Textures/backgroundSkybox_back.tga"
	}

	scene_node "SunLightNode1"
	{
		orientation 1 0 0 45
	}
	light "SunLight1"
	{
		parent "SunLightNode1"
		type directional
		colour 1.0 1.0 1.0
		intensity 0.8 1.0
	}

	scene_node "FinalNode"
	{
		position 0.0 0.0 0.0
		orientation 1.0 0.0 0.0 -90
	}
	mesh "Mesh"
	{
		type "sphere_section" -subdiv=40 -radius=25 -angle=45
		default_material "Material"
	}
	object "FinalPrimitive"
	{
		parent "FinalNode"
		mesh "Mesh"
	}

	scene_node "MainCameraNode"
	{
		position 0.0 44.2305 39.4882
		orientation 0.0 -0.957461 0.288562 180.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 0.1
			far 20000.0
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 800 600
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
