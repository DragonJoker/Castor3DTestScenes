{
	ambient_light 0.2 0.2 0.2
	background_colour 0.5 0.5 0.5 1.0
	include "../Data/Materials/Common.cscn"
	include "../Data/Materials/Hellknight.cscn"

	skybox
	{
		equirectangular "../Data/Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	scene_node "LightNode"
	{
		orientation 1 0 0 -225
	}
	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		illumination 1.0
	}

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 135
		position -336 79 532
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}

