	/**
	*	SKINNING
	*/

	mesh "HellKnightMesh"
	{
		import "../Data/Meshes/Hellknight.cmsh"
		default_materials
		{
			material 0 "hellknight"
			material 1 "gob2"
			material 2 "gob"
			material 3 "tongue"
