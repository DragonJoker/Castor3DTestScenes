sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	min_lod 0.0
	max_lod 5.0
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

material "Clothes"
{
	pass
	{
		albedo 0.588000 0.588000 0.588000 0.00392157
		emissive 0.0
		roughness 0.9
		two_sided false
		colour_blend_mode none

		texture_unit
		{
			levels_count 6
			image "Textures/Lightning/clothes_D.tga"
			albedo_mask 0x00FFFFFF
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			image "Textures/Lightning/clothes_R.tga"
			roughness_mask 0x00FF0000
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			image "Textures/Lightning/clothes_N.tga"
			normal_mask 0x00FFFFFF
			sampler	"Trilinear"
		}
	}
}

