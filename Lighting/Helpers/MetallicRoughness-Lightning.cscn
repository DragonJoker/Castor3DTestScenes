material "Weapon"
{
	pass
	{
		albedo 0.588000 0.588000 0.588000 0.00392157
		emissive 0.0
		roughness 0.2
		metallic 1.0
		two_sided false
		colour_blend_mode none

		texture_unit
		{
			levels_count 6
			image "Textures/Lightning/weapon_D.png"
			albedo_mask 0x00FFFFFF
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			image "Textures/Lightning/weapon_R.png"
			roughness_mask 0xFF000000
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			channel occlusion
			image "Textures/Lightning/weapon_N.png"
			normal_mask 0x00FFFFFF
			occlusion_mask 0xFF000000
			sampler	"Trilinear"
		}
	}
}
