sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	min_lod 0.0
	max_lod 5.0
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

material "Clothes"
{
	pass
	{
		albedo 0.588000 0.588000 0.588000
		emissive 0.0
		specular 0.04 0.04 0.04
		glossiness 1.0
		two_sided false
		colour_blend_mode none

		texture_unit
		{
			levels_count 6
			albedo_mask 0x00FFFFFF
			image "Textures/Lightning/clothes_D.tga"
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			glossiness_mask 0x00FF0000
			image "Textures/Lightning/clothes_G.tga"
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			normal_mask 0x00FFFFFF
			image "Textures/Lightning/clothes_N.tga"
			sampler	"Trilinear"
		}
	}
}

