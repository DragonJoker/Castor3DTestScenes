material "Weapon"
{
	pass
	{
		diffuse 1.000000 1.000000 1.000000
		specular 1.000000 1.000000 1.000000
		shininess 256.0
		texture_unit
		{
			levels_count 6
			diffuse_mask 0x00FFFFFF
			image "Textures/Lightning/weapon_D.png"
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			specular_mask 0x00FFFFFF
			shininess_mask 0xFF000000
			image "Textures/Lightning/weapon_SG.png"
			sampler	"Trilinear"
		}

		texture_unit
		{
			levels_count 6
			occlusion_mask 0xFF000000
			normal_mask 0x00FFFFFF
			image "Textures/Lightning/weapon_N.png"
			sampler	"Trilinear"
		}
	}
}
