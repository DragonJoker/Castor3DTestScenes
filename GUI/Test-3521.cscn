materials pbr

gui
{
	theme "Colours"
	{
		default_font "Arial20"

		panel_style "Panel"
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}

		static_style "Static"
		{
			background_material "Yellow"
			border_material "Teal"
			text_material "DarkBlue"
		}
	}

	panel "Test-BoxLayout-TopLeft"
	{
		theme "Colours"
		pixel_position 0 0
		pixel_size 200 200
		pixel_border_size 8 8 8 8

		static "Text"
		{
			theme "Colours"
			pixel_size 50 50
			pixel_border_size 2 2 2 2
			caption "TL"
			horizontal_align center
			vertical_align center
		}

		box_layout
		{
			horizontal true
			layout_ctrl "Text"
			{
				vertical_align top
			}
			layout_dynspace
		}
	}

