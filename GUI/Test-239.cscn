panel "Tests"
{
	theme "Invisible"
	pixel_position 0 0
	pixel_size 1024 768

	panel "Controls"
	{
		theme "Frame"
		pixel_size 768 668
		pixel_border_size 4 4 4 4

		frame "Colours"
		{
			theme "Colours"
			pixel_size 160 668
			header_caption "Colours"

			content
			{
				button "Coin!!"
				{
					theme "Colours"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					caption "Click Me!!"
				}

				listbox "List"
				{
					theme "Colours"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					item "Item 1"
					item "Item 2"
					item "Item 3"
				}

				combobox "Combo"
				{
					theme "Colours"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					item "Item 1"
					item "Item 2"
					item "Item 3"
				}

				expandable_panel "ExpandablePanel"
				{
					theme "Colours"
					pixel_size 128 100

					header
					{
						pixel_border_size 1 1 1 1

						static "Title"
						{
							theme "Frame"
							pixel_position 1 1
							pixel_size 106 23
							caption "Header"
							horizontal_align left
							vertical_align center
						}
					}

					content
					{
						pixel_border_size 4 4 4 4
					}
				}

				panel "Panel"
				{
					theme "Colours"
					pixel_size 128 50
					pixel_border_size 4 4 4 4
				}

				edit "SingleLineEdit"
				{
					theme "Colours"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
				}

				edit "MultiLineEdit"
				{
					theme "Colours"
					pixel_size 128 50
					pixel_border_size 1 1 1 1
					multiline true
				}

				static "Static"
				{
					theme "Colours"
					pixel_size 128 50
					pixel_border_size 1 1 1 1
					caption "Test static"
				}

				box_layout
				{
					layout_ctrl "Coin!!"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "List"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "Combo"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "ExpandablePanel"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "Panel"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "SingleLineEdit"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "MultiLineEdit"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "Static"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_dynspace
				}
			}
		}

		frame "BackgroundTexture"
		{
			theme "BackgroundTexture"
			pixel_size 160 668
			header_caption "BackgroundTexture"

			content
			{
				button "Coin!!"
				{
					theme "BackgroundTexture"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					caption "Click Me!!"
				}

				listbox "List"
				{
					theme "BackgroundTexture"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					item "Item 1"
					item "Item 2"
					item "Item 3"
