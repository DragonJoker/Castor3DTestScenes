materials phong

font "Arial_20"
{
	file "arial.ttf"
	height 20
}

font "Arial_22"
{
	file "arial.ttf"
	height 22
}

material "DarkerBlue"
{
	pass
	{
		diffuse 0.0 0.0 0.25 1.0
	}
}

material "DarkOrange"
{
	pass
	{
		diffuse 0.5 0.25 0.5 1.0
	}
}

material "ColourMap"
{
	pass
	{
		diffuse 1.0 1.0 1.0

		texture_unit
		{
			image "Textures/Gui/Diffuse.jpg"
			diffuse_mask 0x00FFFFFF
		}
	}
}

material "BtnTexture"
{
	pass
	{
		diffuse 1.0 1.0 1.0

		texture_unit
		{
			image "Textures/Gui/button.png"
			diffuse_mask 0x00FFFFFF
			opacity_mask 0xFF000000
		}
	}
}

material "BtnHighlightedTexture"
{
	pass
	{
		diffuse 1.0 1.0 1.0

		texture_unit
		{
			image "Textures/Gui/button_mo.png"
			diffuse_mask 0x00FFFFFF
			opacity_mask 0xFF000000
		}
	}
}

material "BtnPushedTexture"
{
	pass
	{
		diffuse 1.0 1.0 1.0

		texture_unit
		{
			image "Textures/Gui/button_push.png"
			diffuse_mask 0x00FFFFFF
			opacity_mask 0xFF000000
		}
	}
}

theme "SingleButton"
{
	default_font "Arial_22"

	button_style "Button"
	{
		background_material "BtnTexture"
		border_material "BtnTexture"
		text_material "DarkGray"
		highlighted_background_material "BtnHighlightedTexture"
		highlighted_foreground_material "BtnHighlightedTexture"
		highlighted_text_material "Black"
		pushed_background_material "BtnPushedTexture"
		pushed_foreground_material "BtnPushedTexture"
		pushed_text_material "DarkGray"
	}
}

theme "Frame"
{
	default_font "Arial_20"

	static_style "Static"
	{
		background_material "DarkRed"
		border_material "DarkBlue"
		text_material "White"
	}

	panel_style "Panel"
	{
		background_material "DarkRed"
		border_material "DarkBlue"
	}
}

theme "Invisible"
{
	default_font "Arial_20"

	panel_style "Panel"
	{
		background_material "TransparentBlack"
		border_material "TransparentBlack"
	}
}

theme "Colours"
{
	default_font "Arial_20"

	frame_style "Frame"
	{
		background_material "DarkOrange"
		border_material "White"
		header_text_material "White"
	}

	static_style "Static"
	{
		background_material "White"
		border_material "DarkBlue"
		text_material "DarkBlue"
	}

	button_style "Button"
	{
		background_material "Yellow"
		border_material "Black"
		text_material "Black"
		highlighted_background_material "Yellow"
		highlighted_foreground_material "DarkGray"
		highlighted_text_material "DarkGray"
		pushed_background_material "Yellow"
		pushed_foreground_material "LightGray"
		pushed_text_material "LightGray"
	}

	listbox_style "ListBox"
	{
		background_material "DarkBlue"
		border_material "White"

		item_style
		{
			background_material "DarkBlue"
			border_material "White"
			text_material "White"
		}

		selected_item_style
		{
			background_material "DarkGreen"
			border_material "LightGray"
			text_material "LightGray"
		}

		highlighted_item_style
		{
			background_material "DarkerBlue"
			border_material "White"
			text_material "White"
		}
	}

	edit_style "Edit"
	{
		background_material "White"
		border_material "DarkBlue"
		text_material "DarkBlue"
	}

	combobox_style "ComboBox"
	{
		background_material "DarkBlue"
		border_material "White"

		expand_style
		{
			background_material "DarkBlue"
			border_material "White"
			text_material "White"
			highlighted_background_material "DarkRed"
			highlighted_foreground_material "White"
			highlighted_text_material "White"
			pushed_background_material "DarkGreen"
			pushed_foreground_material "LightGray"
			pushed_text_material "LightGray"
		}

		elements_style
		{
			background_material "DarkBlue"
			border_material "White"

			item_style
			{
				background_material "DarkBlue"
				border_material "White"
				text_material "White"
			}

			selected_item_style
			{
				background_material "DarkGreen"
				border_material "LightGray"
				text_material "LightGray"
			}

			highlighted_item_style
			{
				background_material "DarkRed"
				border_material "White"
				text_material "White"
			}
		}
	}

	panel_style "Panel"
	{
		background_material "DarkRed"
		border_material "DarkBlue"
	}

	expandable_panel_style "ExpandablePanel"
	{
		background_material "TransparentBlack"

		header_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}

		expand_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
			text_material "White"
		}

		content_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}
	}
}

