					layout_dynspace
				}
			}
		}

		box_layout
		{
			horizontal true

			layout_dynspace
			layout_ctrl "Colours"
			{
				stretch true
				padding 5 5 5 5
			}
			layout_dynspace
			layout_ctrl "BackgroundTexture"
			{
				stretch true
				padding 5 5 5 5
			}
			layout_dynspace
			layout_ctrl "ForegroundTexture"
			{
				stretch true
				padding 5 5 5 5
			}
			layout_dynspace
			layout_ctrl "Mix"
			{
				stretch true
				padding 5 5 5 5
			}
			layout_dynspace
		}
	}

	button "Button"
	{
		theme "SingleButton"
		pixel_size 300 50
		center_uv 0.025 0.875 0.975 0.125
		border_inner_uv 0.025 0.125 0.975 0.875
		pixel_border_size 6 6 6 6
		caption "Click Me!!"
	}

	box_layout
	{
		layout_dynspace
		layout_ctrl "Controls"
		{
			horizontal_align center
		}
		layout_dynspace
		layout_ctrl "Button"
		{
			horizontal_align center
		}
		layout_dynspace
	}
}

scene "Scene"
{
	background_image "Textures/backgroundImage.hdr"
	ambient_light 0.0 0.0 0.0

	scene_node "MainCameraNode"
	{
		position 0.0 0.0 -100.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 0.1
			far 100
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 1024 768
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
