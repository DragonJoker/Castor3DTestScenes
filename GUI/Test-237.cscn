materials pbr
include "Materials/Gui.cscn"

font "Arial_20"
{
	file "arial.ttf"
	height 20
}

gui
{
	theme "Colours"
	{
		default_font "Arial_20"

		frame_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}

		edit_style
		{
			background_material "DarkBlue"
			border_material "White"
			text_material "White"
			selection_material "AlphaLightRed"
		}
	}

	frame "TestColours"
	{
		theme "Colours"
		pixel_position 48 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16
		header_caption "Colours"

		content
		{
			edit "SingleLineEdit"
			{
				theme "Colours"
				pixel_position 16 205
				pixel_size 128 25
				pixel_border_size 0 0 0 0
			}
			edit "MultiLineEdit"
			{
				theme "Colours"
				pixel_position 16 240
				pixel_size 128 200
				pixel_border_size 0 0 0 0
				multiline true
			}

			box_layout
			{
				layout_dynspace
				layout_ctrl "SingleLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_ctrl "MultiLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_dynspace
			}
		}
	}

	theme "BackgroundTexture"
	{
		default_font "Arial_20"

		frame_style
		{
			background_material "FrameCenter"
			border_material "DarkRed"
		}

		edit_style
		{
			background_material "FrameCenterMO"
			border_material "DarkGreen"
			text_material "White"
		}
	}

	frame "TestBackgroundTexture"
	{
		theme "BackgroundTexture"
		pixel_position 304 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16
		header_caption "Background"

		content
		{
			edit "SingleLineEdit"
			{
				theme "BackgroundTexture"
				pixel_position 16 205
				pixel_size 128 25
				pixel_border_size 0 0 0 0
			}

			edit "MultiLineEdit"
			{
				theme "BackgroundTexture"
				pixel_position 16 240
				pixel_size 128 200
				pixel_border_size 0 0 0 0
				multiline true
			}

			box_layout
			{
				layout_dynspace
				layout_ctrl "SingleLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}

				layout_ctrl "MultiLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_dynspace
			}
		}
	}

	theme "ForegroundTexture"
	{
		default_font "Arial_20"

		frame_style
		{
			background_material "DarkRed"
			border_material "Frame"
		}

		edit_style
		{
			background_material "DarkBlue"
			border_material "Frame"
			text_material "FrameCenter"
		}
	}

	frame "TestForegroundTexture"
	{
		theme "ForegroundTexture"
		pixel_position 560 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16
		header_caption "Foreground"

		content
		{
			edit "SingleLineEdit"
			{
				theme "ForegroundTexture"
				pixel_size 128 25
				pixel_border_size 0 0 0 0
			}
			edit "MultiLineEdit"
			{
				theme "ForegroundTexture"
				pixel_size 128 200
				pixel_border_size 0 0 0 0
				multiline true
			}

			box_layout
			{
				layout_dynspace
				layout_ctrl "SingleLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_ctrl "MultiLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_dynspace
			}
		}
	}

	theme "BothTextures"
	{
		default_font "Arial_20"

		frame_style
		{
			background_material "FrameCenter"
			border_material "Frame"
		}

		edit_style
		{
			background_material "FrameCenterMO"
			border_material "Frame"
			text_material "FrameCenter"
		}
	}

	frame "TestBothTextures"
	{
		theme "BothTextures"
		pixel_position 816 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16
		header_caption "Both"

		content
		{
			edit "SingleLineEdit"
			{
				theme "BothTextures"
				pixel_size 128 25
				pixel_border_size 0 0 0 0
			}

			edit "MultiLineEdit"
			{
				theme "BothTextures"
				pixel_size 128 200
				pixel_border_size 0 0 0 0
				multiline true
			}

			box_layout
			{
				layout_dynspace
				layout_ctrl "SingleLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_ctrl "MultiLineEdit"
				{
					stretch true
					padding 0 5 0 5
				}
				layout_dynspace
			}
		}
	}
}

scene "Scene"
{
	background_image "Textures/backgroundImage.hdr"
	ambient_light 0.0 0.0 0.0

	scene_node "MainCameraNode"
	{
		position 0.0 0.0 -100.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1
			far 100
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 1024 768
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
