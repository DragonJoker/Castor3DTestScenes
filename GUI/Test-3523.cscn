materials pbr
include "Materials/Gui.cscn"

theme "Colours"
{
	default_font "Dbbrnms_25"

	expandable_panel_style "ExpandablePanel"
	{
		background_material "TransparentBlack"

		header_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}

		expand_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
			text_material "White"
		}

		content_style
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}
	}

	static_style "Static"
	{
		background_material "DarkRed"
		border_material "DarkBlue"
		text_material "White"
	}
}

theme "ColoursInner"
{
	default_font "Dbbrnms_25"

	expandable_panel_style "ExpandablePanel"
	{
		background_material "TransparentBlack"

		header_style
		{
			background_material "DarkGreen"
			border_material "DarkBlue"
		}

		expand_style
		{
			background_material "DarkGreen"
			border_material "DarkBlue"
			text_material "White"
		}

		content_style
		{
			background_material "DarkGreen"
			border_material "DarkBlue"
		}
	}

	static_style "Static"
	{
		background_material "DarkGreen"
		border_material "DarkBlue"
		text_material "White"
	}
}

expandable_panel "TestColours"
{
	theme "Colours"
	pixel_position 48 0
	pixel_size 160 768

	header
	{
		pixel_border_size 1 1 1 1

		static "Title"
		{
			theme "Colours"
			pixel_position 0 0
			pixel_size 148 25
			caption "Outer"
			horizontal_align left
			vertical_align center
		}
	}

	content
	{
		pixel_border_size 16 16 16 16

		expandable_panel "Inner"
		{
			theme "ColoursInner"
			pixel_position 16 300
			pixel_size 128 100

			header
			{
				pixel_border_size 1 1 1 1

				static "Title"
				{
					theme "ColoursInner"
					pixel_position 0 0
					pixel_size 106 25
					caption "Inner"
					horizontal_align left
					vertical_align center
				}
			}

			content
			{
				pixel_border_size 4 4 4 4
			}
		}
	}
}

