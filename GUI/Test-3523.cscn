expandable_panel "BothTextures"
{
	theme "BothTextures"
	pixel_position 816 0
	pixel_size 160 768

	header
	{
		pixel_border_size 1 1 1 1

		static "Title"
		{
			theme "BothTextures"
			pixel_position 0 0
			pixel_size 148 25
			caption "Outer"
			horizontal_align left
