					}
					layout_ctrl "Panel"
					{
						horizontal_align center
						padding 5 5 5 5
					}
					layout_ctrl "SingleLineEdit"
					{
						horizontal_align center
						padding 5 5 5 5
					}
					layout_ctrl "MultiLineEdit"
					{
						horizontal_align center
