					caption "Test static"
				}

				box_layout
				{
					layout_dynspace
					layout_ctrl "Button"
					{
						horizontal_align center
						padding 5 5 5 5
					}
					layout_ctrl "ListBox"
					{
						horizontal_align center
						padding 5 5 5 5
					}
					layout_ctrl "ComboBox"
					{
						horizontal_align center
						padding 5 5 5 5
					}
					layout_ctrl "ExpandablePanel"
					{
						horizontal_align center
