}

listbox_style "Colours/ListBox"
{
	background_material "DarkBlue"
	border_material "White"

	item_style
	{
		background_material "DarkBlue"
		border_material "White"
		font "Arial_20"
		text_material "White"
	}

	selected_item_style
	{
