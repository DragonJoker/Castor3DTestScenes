panel "Tests"
{
	style "Invisible"
	pixel_position 0 0
	pixel_size 1024 768

	panel "Controls"
	{
		style "Frame/Panel"
		pixel_size 768 668
		pixel_border_size 4 4 4 4

		frame "Colours"
		{
			style "Colours/Frame"
			pixel_size 160 668
			header_caption "Colours"

			content
			{
				button "Button"
				{
					style "Colours/Button"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					caption "Click Me!!"
				}

				listbox "ListBox"
				{
					style "Colours/ListBox"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					item "Item 1"
					item "Item 2"
					item "Item 3"
				}

				combobox "ComboBox"
				{
					style "Colours/ComboBox"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					item "Item 1"
					item "Item 2"
					item "Item 3"
				}

				expandable_panel "ExpandablePanel"
				{
					style "Colours/ExpandablePanel"
					pixel_size 128 100

					header
					{
						pixel_border_size 1 1 1 1

						static "Title"
						{
							style "Frame/Static"
							pixel_position 1 1
							pixel_size 106 23
							caption "Header"
							horizontal_align left
							vertical_align center
						}
					}

					content
					{
						pixel_border_size 4 4 4 4
					}
				}

				panel "Panel"
				{
					style "Colours/Panel"
					pixel_size 128 50
					pixel_border_size 4 4 4 4
				}

				edit "SingleLineEdit"
				{
					style "Colours/SingleLineEdit"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
				}

				edit "MultiLineEdit"
				{
					style "Colours/MultiLineEdit"
					pixel_size 128 50
					pixel_border_size 1 1 1 1
					multiline true
				}

				static "Static"
				{
					style "Colours/Static"
					pixel_size 128 50
					pixel_border_size 1 1 1 1
					caption "Test static"
				}

				box_layout
				{
					layout_ctrl "Button"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "ListBox"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "ComboBox"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "ExpandablePanel"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "Panel"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "SingleLineEdit"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "MultiLineEdit"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_ctrl "Static"
					{
						horizontal_align left
						padding 5 5 5 5
					}
					layout_dynspace
				}
			}
		}

		frame "BackgroundTexture"
		{
			style "BackgroundTexture/Frame"
			pixel_size 160 668
			header_caption "BackgroundTexture"

			content
			{
				button "Button"
				{
					style "BackgroundTexture/Button"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
					caption "Click Me!!"
				}

				listbox "ListBox"
				{
					style "BackgroundTexture/ListBox"
					pixel_size 128 25
					pixel_border_size 1 1 1 1
