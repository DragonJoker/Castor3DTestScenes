					item "Item 3"
				}

				expandable_panel "ExpandablePanel"
				{
					style "BackgroundTexture/ExpandablePanel"
					pixel_size 128 100

					header
					{
						pixel_border_size 1 1 1 1

						static "Title"
						{
							style "Frame/Static"
							pixel_position 1 1
							pixel_size 106 23
							caption "Header"
							horizontal_align left
							vertical_align center
						}
					}

					content
