materials pbr
include "Materials/Gui.cscn"

// GUI

theme "Menu"
{
	default_font "Dbbrnms_25"

	button_style "Jouer"
	{
		background_material "Commencer"
		highlighted_background_material "CommencerMO"
		pushed_background_material "CommencerMO"
	}

	button_style "Regles"
	{
		background_material "Regles"
		highlighted_background_material "ReglesMO"
		pushed_background_material "ReglesMO"
	}

	button_style "Retour"
	{
		background_material "Retour"
		highlighted_background_material "RetourMO"
		pushed_background_material "RetourMO"
	}

	button_style "Continuer"
	{
		background_material "Continuer"
		highlighted_background_material "ContinuerMO"
		pushed_background_material "ContinuerMO"
	}

	button_style "Recommencer"
	{
		background_material "Recommencer"
		highlighted_background_material "RecommencerMO"
		pushed_background_material "RecommencerMO"
	}

	button_style "Menu"
	{
		background_material "MenuInGame"
		highlighted_background_material "MenuInGameMO"
		pushed_background_material "MenuInGameMO"
	}

	panel_style "Title"
	{
		background_material "Titre"
	}

	panel_style "BottomRightCorner"
	{
		background_material "BasDroite"
	}

	panel_style "Menu"
	{
		background_material "BaseMenu"
	}
}

panel "Title"
{
	style "Menu/Title"
	pixel_position 256 192
	pixel_size 512 384
}

panel "BottomRightCorner"
{
	style "Menu/BottomRightCorner"
	pixel_position 768 512
	pixel_size 256 256
}

panel "Menu"
{
	style "Menu/Menu"
	pixel_position 0 0
	pixel_size 341 768

	button "Jouer"
	{
		style "Menu/Jouer"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	button "Regles"
	{
		style "Menu/Regles"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	button "Retour"
	{
		style "Menu/Retour"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	button "Continuer"
	{
		style "Menu/Continuer"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	button "Recommencer"
	{
		style "Menu/Recommencer"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	button "Menu"
	{
		style "Menu/Menu"
		pixel_size 128 64
		pixel_border_size 0 0 0 0
	}

	box_layout
	{
		layout_dynspace
		layout_ctrl "Jouer"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_ctrl "Regles"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_ctrl "Retour"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_ctrl "Continuer"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_ctrl "Recommencer"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_ctrl "Menu"
		{
			horizontal_align left
			padding 32 16 16 16
		}
		layout_dynspace
	}
}

// SCENE

scene "Scene"
{
	background_image "Textures/backgroundImage.hdr"
	ambient_light 0.0 0.0 0.0

	scene_node "MainCameraNode"
	{
		position 0.0 0.0 -100.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 0.1
			far 20000
		}
	}
}

// WINDOW

window "Window"
{
	render_target
	{
		format argb32
		size 1024 768
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
