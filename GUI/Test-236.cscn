materials pbr
include "Materials/Gui.cscn"

gui
{
	theme "Colours"
	{
		default_font "Dbbrnms_25"

		panel_style "Panel"
		{
			background_material "DarkRed"
			border_material "DarkBlue"
		}

		combobox_style "ComboBox"
		{
			background_material "DarkBlue"
			border_material "White"

			expand_style
			{
				background_material "DarkBlue"
				border_material "White"
				text_material "White"
				highlighted_background_material "DarkerBlue"
				highlighted_foreground_material "White"
				highlighted_text_material "White"
				pushed_background_material "DarkGreen"
				pushed_foreground_material "LightGray"
				pushed_text_material "LightGray"
			}

			elements_style
			{
				background_material "DarkBlue"
				border_material "White"
				text_material "White"

				item_style
				{
					background_material "DarkBlue"
					border_material "White"
					text_material "White"
				}

				selected_item_style
				{
					background_material "DarkGreen"
					border_material "LightGray"
					text_material "LightGray"
				}

				highlighted_item_style
				{
					background_material "DarkRed"
					border_material "White"
					text_material "White"
				}
			}
		}
	}

	panel "TestColours"
	{
		theme "Colours"
		pixel_position 48 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16

		combobox "TestCombo"
		{
			theme "Colours"
			pixel_position 16 170
			pixel_size 128 25
			pixel_border_size 4 4 4 4
			item "Item 1"
			item "Item 2"
			item "Item 3"
		}
	}

	theme "BackgroundTexture"
	{
		default_font "Dbbrnms_25"

		panel_style "Panel"
		{
			background_material "FrameCenter"
			border_material "DarkRed"
		}

		combobox_style "ComboBox"
		{
			background_material "FrameCenterMP"
			border_material "White"

			expand_style
			{
				background_material "FrameCenterMP"
				border_material "White"
				text_material "Black"
				highlighted_background_material "NoBorderMenuCenter"
				highlighted_foreground_material "White"
				highlighted_text_material "White"
				pushed_background_material "FrameCenterMO"
				pushed_foreground_material "LightGray"
				pushed_text_material "LightGray"
			}

			elements_style
			{
				background_material "FrameCenterMP"
				border_material "White"

				item_style
				{
					background_material "FrameCenterMP"
					border_material "White"
					text_material "Black"
				}

				selected_item_style
				{
					background_material "FrameCenterMO"
					border_material "LightGray"
					text_material "DarkGray"
				}

				highlighted_item_style
				{
					background_material "NoBorderMenuCenter"
					border_material "White"
					text_material "Black"
				}
			}
		}
	}

	panel "TestBackgroundTexture"
	{
		theme "BackgroundTexture"
		pixel_position 304 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16

		combobox "BT TestCombo"
		{
			theme "BackgroundTexture"
			pixel_position 16 170
			pixel_size 128 25
			pixel_border_size 4 4 4 4
			item "Item 1"
			item "Item 2"
			item "Item 3"
		}
	}

	theme "ForegroundTexture"
	{
		default_font "Dbbrnms_25"

		panel_style "Panel"
		{
			background_material "DarkRed"
			border_material "Frame"
		}

		combobox_style "ComboBox"
		{
			background_material "DarkBlue"
			border_material "FrameMP"

			expand_style
			{
				background_material "DarkBlue"
				border_material "FrameMP"
				text_material "FrameMP"
				highlighted_background_material "DarkerBlue"
				highlighted_foreground_material "FrameMP"
				highlighted_text_material "FrameMP"
				pushed_background_material "DarkGreen"
				pushed_foreground_material "FrameMO"
				pushed_text_material "FrameMO"
			}

			elements_style
			{
				background_material "DarkBlue"
				border_material "FrameMP"

				item_style
				{
					background_material "DarkBlue"
					border_material "FrameMP"
					text_material "FrameMP"
				}

				selected_item_style
				{
					background_material "DarkGreen"
					border_material "FrameMO"
					text_material "FrameMO"
				}

				highlighted_item_style
				{
					background_material "DarkRed"
					border_material "FrameMP"
					text_material "FrameMP"
				}
			}
		}
	}

	panel "TestForegroundTexture"
	{
		theme "ForegroundTexture"
		pixel_position 560 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16

		combobox "FT TestCombo"
		{
			theme "ForegroundTexture"
			pixel_position 16 170
			pixel_size 128 25
			pixel_border_size 4 4 4 4
			item "Item 1"
			item "Item 2"
			item "Item 3"
		}
	}

	theme "BothTextures"
	{
		default_font "Dbbrnms_25"

		panel_style "Panel"
		{
			background_material "FrameCenter"
			border_material "Frame"
		}

		combobox_style "ComboBox"
		{
			background_material "FrameCenterMP"
			border_material "FrameMP"

			expand_style
			{
				background_material "FrameCenterMP"
				border_material "FrameMP"
				text_material "Black"
				highlighted_background_material "NoBorderMenuCenter"
				highlighted_foreground_material "FrameMP"
				highlighted_text_material "FrameMP"
				pushed_background_material "FrameCenterMO"
				pushed_foreground_material "FrameMO"
				pushed_text_material "FrameMO"
			}

			elements_style
			{
				background_material "FrameCenterMP"
				border_material "FrameMP"

				item_style
				{
					background_material "FrameCenterMP"
					border_material "FrameMP"
					text_material "Black"
				}

				selected_item_style
				{
					background_material "FrameCenterMO"
					border_material "FrameMO"
					text_material "DarkGray"
				}

				highlighted_item_style
				{
					background_material "NoBorderMenuCenter"
					border_material "FrameMP"
					text_material "Black"
				}
			}
		}
	}

	panel "TestBothTextures"
	{
		theme "BothTextures"
		pixel_position 816 0
		pixel_size 160 768
		pixel_border_size 16 16 16 16

		combobox "BFT TestCombo"
		{
			theme "BothTextures"
			pixel_position 16 170
			pixel_size 128 25
			pixel_border_size 4 4 4 4
			item "Item 1"
			item "Item 2"
			item "Item 3"
		}
	}
}

scene "Scene"
{
	background_image "Textures/backgroundImage.hdr"
	ambient_light 0.0 0.0 0.0

	scene_node "MainCameraNode"
	{
		position 0.0 0.0 -100.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1
			far 100
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 1024 768
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
