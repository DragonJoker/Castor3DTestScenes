// Global configuration
materials c3d.pbr

scene "BaltardOut"
{
	// Scene configuration
	ambient_light 1.00000 1.00000 1.00000
	background_colour 0.500000 0.500000 0.500000
	lpv_indirect_attenuation 1.70000
	include "Helpers/BaltardOut-Textures-SpecularGlossiness.cscn"
	include "Helpers/BaltardOut-Materials-SpecularGlossiness.cscn"
	include "Helpers/BaltardOut-Meshes.cscn"
	include "Helpers/BaltardOut-Nodes.cscn"
	include "Helpers/BaltardOut-Objects.cscn"
	include "Helpers/BaltardOut-Lights-SpecularGlossiness.cscn"

	//Skybox

	atmospheric_scattering
	{
		sunNode "LightNode"
		planetNode "PlanetNode"
		transmittanceResolution 256 64
		multiScatterResolution 32
		atmosphereVolumeResolution 32
		sunIlluminance 1.00000 1.00000 1.00000
		sunIlluminanceScale 1.00000
		rayMarchMinSPP 4
		rayMarchMaxSPP 14
		multipleScatteringFactor 1.00000
		solarIrradiance 1.00000 1.00000 1.00000
		sunAngularRadius 0.00467500
		absorptionExtinction 0.000650000 0.00188100 8.50000e-05
		maxSunZenithAngle 0.0310714
		rayleighScattering 0.00580200 0.0135580 0.0331000
		mieScattering 0.00399600 0.00399600 0.00399600
		miePhaseFunctionG 0.800000
		mieExtinction 0.00444000 0.00444000 0.00444000
		bottomRadius 6360.00
		topRadius 6460.00
		groundAlbedo 0.00000 0.00000 0.00000

		minRayleighDensity
		{
			layerWidth 0.00000
			expTerm 0.00000
			expScale 0.00000
			linearTerm 0.00000
			constantTerm 0.00000
		}

		maxRayleighDensity
		{
			layerWidth 0.00000
			expTerm 1.00000
			expScale -0.125000
			linearTerm 0.00000
			constantTerm 0.00000
		}

		minMieDensity
		{
			layerWidth 0.00000
			expTerm 0.00000
			expScale 0.00000
			linearTerm 0.00000
			constantTerm 0.00000
		}

		maxMieDensity
		{
			layerWidth 0.00000
			expTerm 1.00000
			expScale -0.833330
			linearTerm 0.00000
			constantTerm 0.00000
		}

		minAbsorptionDensity
		{
			layerWidth 25.0000
			expTerm 0.00000
			expScale 0.00000
			linearTerm 0.0666660
			constantTerm -0.666660
		}

		maxAbsorptionDensity
		{
			layerWidth 0.00000
			expTerm 0.00000
			expScale 0.00000
			linearTerm -0.0666660
			constantTerm 2.66666
		}

		weather
		{
			worleyResolution 32
			perlinWorleyResolution 128
			curlResolution 128
			weatherResolution 1024
			amplitude 0.500000
			frequency 0.800000
			scale 100.000
			octaves 4
		}

		clouds
		{
			windDirection 0.500000 0.00000 0.100000
			speed 10.0000
			coverage 0.00000
			crispiness 40.0000
			curliness 0.100000
			density 0.200000
			absorption 0.250000
			innerRadius 50.0000
			outerRadius 170.000
			topColour 0.994118 0.876471 0.876471
			bottomColour 0.382353 0.411765 0.470588
			enablePowder true
			topOffset 0.750000
		}
	}

	//Cameras nodes

	scene_node "CameraNode"
	{
		orientation 0.479944 -0.846948 0.228763 58.7399
		position 110.000 46.2000 -31.8000
	}

	//Cameras

	camera "MainCamera"
	{
		parent "CameraNode"

		viewport
		{
			type perspective
			near 1.00000
			far 11000.0
			aspect_ratio 1.77800
			fov_y 45.0000
		}
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format rgba32
		tone_mapping "linear"
		scene "BaltardOut"
		camera "MainCamera"

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer false
			blur_high_quality false
			intensity 1.00000
			radius 50.0000
			bias 0.0230000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
