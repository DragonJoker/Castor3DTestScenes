// Global configuration
materials pbr

scene "Bistro"
{
	// Scene configuration
	ambient_light 0.00000 0.00000 0.00000
	background_colour 0.00000 0.00000 0.00000
	lpv_indirect_attenuation 1.70000
	include "../Data/Helpers/Bistro-Materials.cscn"
	include "../Data/Helpers/Bistro-Meshes.cscn"
	include "../Data/Helpers/Bistro-Nodes.cscn"
	include "../Data/Helpers/Bistro-Lights.cscn"
	include "../Data/Helpers/Bistro-Objects.cscn"

	//Skybox

	atmospheric_scattering
	{
		sunNode "LightNode"
		planetNode "PlanetNode"
		transmittanceResolution 256 64
		multiScatterResolution 32
		atmosphereVolumeResolution 32
		skyViewResolution 192 108

		atmosphere
		{
			sunIlluminance 1.0 1.0 1.0
			sunIlluminanceScale 1.0
			rayMarchMinSPP 4
			rayMarchMaxSPP 14
			multipleScatteringFactor 1.0

			// The solar irradiance at the top of the atmosphere.
			solarIrradiance 1.0 1.0 1.0

			// The sun's angular radius. Warning: the implementation uses approximations
			// that are valid only if this angle is smaller than 0.1 radians.
			sunAngularRadius 0.004675

			// The extinction coefficient of molecules that absorb light (e.g. ozone) at
			// the altitude where their density is maximum, as a function of wavelength.
			// The extinction coefficient at altitude h is equal to
			// 'absorption_extinction' times 'absorption_density' at this altitude.
			absorptionExtinction 0.000650 0.001881 0.000085

			// The maximum Sun zenith angle for which atmospheric scattering
			// must be precomputed (for maximum precision, use the smallest Sun zenith
			// angle yielding negligible sky light radiance values. For instance, for the
			// Earth case, 102 degrees is a good choice - yielding mu_s_min = -0.2).
			maxSunZenithAngle 102.0

			// The scattering coefficient of air molecules at the altitude where their
			// density is maximum (usually the bottom of the atmosphere), as a function of
			// wavelength. The scattering coefficient at altitude h is equal to
			// 'rayleigh_scattering' times 'rayleigh_density' at this altitude.
			rayleighScattering 0.005802 0.013558 0.033100

			// The scattering coefficient of aerosols at the altitude where their density
			// is maximum (usually the bottom of the atmosphere), as a function of
			// wavelength. The scattering coefficient at altitude h is equal to
			// 'mie_scattering' times 'mie_density' at this altitude.
			mieScattering 0.003996 0.003996 0.003996

			// The asymetry parameter for the Cornette-Shanks phase function for the
			// aerosols.
			miePhaseFunctionG 0.8

			// The extinction coefficient of aerosols at the altitude where their density
			// is maximum (usually the bottom of the atmosphere), as a function of
			// wavelength. The extinction coefficient at altitude h is equal to
			// 'mie_extinction' times 'mie_density' at this altitude.
			mieExtinction 0.004440 0.004440 0.004440

			// The distance between the planet center and the bottom of the atmosphere.
			bottomRadius 6360.0

			// The distance between the planet center and the top of the atmosphere.
			topRadius 6460.0

			// The average albedo of the ground.
			groundAlbedo 0.0 0.0 0.0

			// The density profile of air molecules, i.e. a function from altitude to
			// dimensionless values between 0 (min density) and 1 (maximum density).
			minRayleighDensity
			{
				layerWidth 0.0
				expTerm 0.0
				expScale 0.0
				linearTerm 0.0
				constantTerm 0.0
			}
			maxRayleighDensity
			{
				layerWidth 0.0
				expTerm 1.0
				expScale -0.125 // -1 / 8
				linearTerm 0.0
				constantTerm 0.0
			}

			// The density profile of aerosols, i.e. a function from altitude to
			// dimensionless values between 0 (min density) and 1 (maximum density).
			minMieDensity
			{
				layerWidth 0.0
				expTerm 0.0
				expScale 0.0
				linearTerm 0.0
				constantTerm 0.0
			}
			maxMieDensity
			{
				layerWidth 0.0
				expTerm 1.0
				expScale -0.83333 // -1 / 1.2
				linearTerm 0.0
				constantTerm 0.0
			}

			// The density profile of air molecules that absorb light (e.g. ozone), i.e.
			// a function from altitude to dimensionless values between 0 (min density)
			// and 1 (maximum density).
			minAbsorptionDensity
			{
				layerWidth 25.0
				expTerm 0.0
				expScale 0.0
				linearTerm 0.066666 // 1 / 15
				constantTerm -0.66666 // -2 / 3
			}
			maxAbsorptionDensity
			{
				layerWidth 0.0
				expTerm 0.0
				expScale 0.0
				linearTerm -0.066666 // -1 / 15
				constantTerm 2.66666 // 8 / 3
			}
		}

		clouds
		{
			coverage 0.0
		}
	}

	//Voxel Cone Tracing

	voxel_cone_tracing
	{
		enabled true
		grid_size 256
		conservative_rasterization true
		temporal_smoothing false
		occlusion false
		secondary_bounce true
		num_cones 16
		max_distance 10.0000
		ray_step_size 0.125000
		voxel_size 2.00000
	}

	//Cameras nodes

	scene_node "InteriorMainCameraNode"
	{
		orientation 0 1 0 90
		position -0.442365 1.54 -1.11186
	}

	scene_node "ExteriorMainCameraNode"
	{
		orientation 0.138915 0.983574 -0.115261 80.3007
		position -13.0816 3.09069 -0.0904408
	}

	//Cameras

	camera "ExteriorMainCamera"
	{
		parent "ExteriorMainCameraNode"

		viewport
		{
			type perspective
			near 0.10000
			far 200.000
			aspect_ratio 1.77800
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}

	camera "InteriorMainCamera"
	{
		parent "InteriorMainCameraNode"

		viewport
		{
			type perspective
			near 0.10000
			far 200.000
			aspect_ratio 1.77800
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format rgba32
		tone_mapping "aces"
		scene "Bistro"
		camera "ExteriorMainCamera"
		postfx "pbr_bloom"

		smaa
		{
			mode 1X
			preset ultra
			edgeDetection colour
		}

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer true
			blur_high_quality true
			intensity 1.00000
			radius 0.200000
			bias 0.0250000
			num_samples 23
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
