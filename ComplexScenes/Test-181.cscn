// Global configuration
materials c3d.pbr

scene "BaltardIn"
{
	// Scene configuration
	ambient_light 1.00000 1.00000 1.00000
	background_colour 0.0100000 0.0100000 0.0100000
	lpv_indirect_attenuation 1.70000
	include "Helpers/BaltardIn-Samplers.cscn"
	include "Helpers/BaltardIn-Textures-SpecularGlossiness.cscn"
	include "Helpers/BaltardIn-Materials-SpecularGlossiness.cscn"
	include "Helpers/BaltardIn-Meshes.cscn"
	include "Helpers/BaltardIn-Nodes.cscn"
	include "Helpers/BaltardIn-Objects.cscn"

	//Skybox

	skybox
	{
		right "Textures/cube_map_baltard_ns_RT.jpg"
		left "Textures/cube_map_baltard_ns_LF.jpg"
		bottom "Textures/cube_map_baltard_ns_DN.jpg"
		top "Textures/cube_map_baltard_ns_UP.jpg"
		back "Textures/cube_map_baltard_ns_FR.jpg"
		front "Textures/cube_map_baltard_ns_BK.jpg"
	}

	//Cameras nodes

	scene_node "MainCameraNode"
	{
		position 7.45687 34.1209 -113.500
	}

	//Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"

		viewport
		{
			type perspective
			near 0.500000
			far 1200.00
			aspect_ratio 1.77800
			fov_y 45.0000
		}
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format rgba32
		tone_mapping "linear"
		scene "BaltardIn"
		camera "MainCamera"

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer false
			blur_high_quality false
			intensity 1.00000
			radius 5.00000
			bias 0.0230000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
