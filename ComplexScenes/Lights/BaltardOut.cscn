// Lights

light "light_01"
{
	parent "LightNode"
	type directional
	colour 1 1 1
	intensity 0.7 0.8
	shadows
	{
		producer true
		filter pcf
		global_illumination lpv
		rsm_config
		{
			intensity 1
			max_radius 0.03
			sample_count 100
		}
		lpv_config
		{
			texel_area_modifier 1
		}
		raw_config
		{
			min_offset 0.0
			max_slope_offset 0.001
		}
		pcf_config
		{
			min_offset 0.0001
			max_slope_offset 0.0001
		}
		vsm_config
		{
			min_variance 0.0000001
			light_bleeding_reduction 0.0
		}
	}
}
