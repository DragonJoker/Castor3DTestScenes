// Global configuration
materials pbr
max_image_size 512

scene "SanMiguel"
{
	// Scene configuration
	ambient_light 0.00000 0.00000 0.00000
	background_colour 0.00000 0.00000 0.00000
	lpv_indirect_attenuation 0.20000
	include "Helpers/SanMiguel-Textures-SpecularGlossiness.cscn"
	include "Helpers/SanMiguel-Materials-SpecularGlossiness.cscn"
	include "Helpers/SanMiguel-Meshes.cscn"
	include "Helpers/SanMiguel-Nodes.cscn"
	include "Helpers/SanMiguel-Objects.cscn"
	include "Helpers/SanMiguel-Lights-VLS.cscn"
	//include "Helpers/SanMiguel-Lights.cscn"

	// Skybox

	skybox
	{
		equirectangular "Textures/pineTreeSkybox.hdr" 512
	}

	// Cameras nodes

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 310
		position 23.6159 1.65023 -1.66404
		//orientation -0.0157667 -0.996433 0.0829025 201.461
		//position 14.7131 1.6325 5.19296
	}

	// Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"

		viewport
		{
			type perspective
			near 0.100000
			far 100.000
			aspect_ratio 1.77800
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}
}

// Windows

window "SanMiguel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1280 720
		//size 1920 1080
		format argb32
		scene "SanMiguel"
		camera "MainCamera"
		tone_mapping "linear"
		postfx "pbr_bloom"

		smaa
		{
			mode 1X
			edgeDetection colour
			preset ultra
			enableReprojection false
		}

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer true
			blur_high_quality true
			intensity 1.00000
			radius 0.750000
			bias 0.0230000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
