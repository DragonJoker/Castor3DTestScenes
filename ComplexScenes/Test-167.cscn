// Global configuration
materials c3d.phong

scene "Boite"
{
	// Scene configuration
	ambient_light 0.0100000 0.0100000 0.0100000
	background_colour 0.0100000 0.0100000 0.0100000
	lpv_indirect_attenuation 1.70000
	include "Helpers/Boite-Samplers.cscn"
	include "Helpers/Boite-Textures-BlinnPhong.cscn"
	include "Helpers/Boite-Materials-BlinnPhong.cscn"
	include "Helpers/Boite-Meshes.cscn"
	include "Helpers/Boite-Nodes.cscn"
	include "Helpers/Boite-Objects.cscn"
	include "Helpers/Boite-Lights.cscn"

	//Cameras nodes

	scene_node "CameraNode"
	{
		position 44.5000 20.0000 -54.7000
		scale 0.100000 0.100000 0.100000
	}

	//Cameras

	camera "MainCamera"
	{
		parent "CameraNode"

		viewport
		{
			type perspective
			near 0.500000
			far 1200.00
			aspect_ratio 1.77800
			fov_y 45.0000
		}
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format rgba32
		tone_mapping "linear"
		scene "Boite"
		camera "MainCamera"

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer false
			blur_high_quality false
			intensity 1.00000
			radius 5.00000
			bias 0.0230000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
