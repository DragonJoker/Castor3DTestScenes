// Global configuration
materials c3d.phong

scene "BaltardOut"
{
	// Scene configuration
	ambient_light 0.200000 0.200000 0.200000
	background_colour 0.500000 0.500000 0.500000
	lpv_indirect_attenuation 1.70000
	include "Helpers/BaltardOut-Textures-BlinnPhong.cscn"
	include "Helpers/BaltardOut-Materials-BlinnPhong.cscn"
	include "Helpers/BaltardOut-Meshes.cscn"
	include "Helpers/BaltardOut-Nodes.cscn"
	include "Helpers/BaltardOut-Objects.cscn"
	include "Helpers/BaltardOut-Lights-BlinnPhong.cscn"

	//Skybox

	skybox
	{
		equirectangular "Textures/skybox.hdr" 1024
	}

	//Cameras nodes

	scene_node "CameraNode"
	{
		orientation 0.479944 -0.846948 0.228763 58.7399
		position 110.000 46.2000 -31.8000
	}

	//Cameras

	camera "MainCamera"
	{
		parent "CameraNode"

		viewport
		{
			type perspective
			near 1.00000
			far 11000.0
			aspect_ratio 1.77800
			fov_y 45.0000
		}
	}
}

//Windows

window "RenderPanel"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format rgba32
		tone_mapping "linear"
		scene "BaltardOut"
		camera "MainCamera"

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer false
			blur_high_quality false
			intensity 1.00000
			radius 50.0000
			bias 0.0230000
			num_samples 19
			edge_sharpness 1.00000
			blur_step_size 2
			blur_radius 4
			bend_step_count 4
			bend_step_size 0.500000
		}
	}
}
