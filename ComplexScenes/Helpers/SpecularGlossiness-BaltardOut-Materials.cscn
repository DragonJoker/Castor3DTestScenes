// Samplers

sampler "Default"
{
	min_filter linear
	mag_filter linear
	mip_filter nearest
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "abris_bus/metal"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 0.310907 0.310907 0.310907
		specular 0.432000 0.432000 0.432000
		roughness 0.250000

		texture_unit
		{
			levels_count 7
			image "Textures/SpecularGlossiness-BaltardOut/abris_bus_metal.dds"
			colour_mask 0x00ffffff
			invert_y true
		}
	}
}

