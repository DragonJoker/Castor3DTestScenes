	parent "spot_06"
	type spot
	colour 1.00000 1.00000 1.00000
	intensity 1.00000 1.00000
	attenuation 1.00000 0.0100000 0.00000
	exponent 1.00000
	cut_off 10.0000
	shadow_producer false

	shadows
	{
		filter none
		producer false
		global_illumination none

		raw_config
		{
			min_offset 0.00000
			max_slope_offset 0.00000
		}

		pcf_config
		{
			min_offset 0.00000
			max_slope_offset 0.00000
		}

		vsm_config
		{
			variance_max 0.00000
			variance_bias 0.00000
		}

		rsm_config
		{
			intensity 0.00000
			max_radius 0.00000
			sample_count 100
		}

		lpv_config
		{
			texel_area_modifier 0.00000
		}
	}
}

