// Lights

light "light_01"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	intensity 0.700000 0.800000

	shadows
	{
		filter pcf
		producer true
		global_illumination lpv

		raw_config
		{
			min_offset 0.00000
			max_slope_offset 0.00100000
		}

		pcf_config
		{
			min_offset 0.000100000
			max_slope_offset 0.000100000
			filter_size 4
			sample_count 8
		}

		vsm_config
		{
			min_variance 1.00000e-07
			light_bleeding_reduction 0.00000
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
