// Samplers

sampler "TriLinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

// Materials

material "baltard_in_ns/armature"
{
	pass
	{
		albedo 0.588235 0.588235 0.588235
		roughness 0.5
		metalness 1
		two_sided true
	}
}

material "baltard_in_ns/baffles"
{
	pass
	{
		albedo 1.00000 1.00000 1.00000
		two_sided true

		texture_unit
		{
			levels_count 9
			sampler "TriLinear"
			image "Textures/BaltardIn/baffles.jpg"
			albedo_mask 0x00FFFFFF
		}
	}
}

