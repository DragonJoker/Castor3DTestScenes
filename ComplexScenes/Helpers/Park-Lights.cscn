// Lights

light "light_01"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	intensity 7.00000 8.00000

	shadows
	{
		producer true
		filter variance
		// global_illumination lpv_geometry
		volumetric_steps 20
		volumetric_scattering 0.900000

		raw_config
		{
			min_offset 0.00001
			max_slope_offset 0.0001
		}

		pcf_config
		{
			min_offset 0.00001
			max_slope_offset 0.0001
		}

		vsm_config
		{
			min_variance 0.0000001
			light_bleeding_reduction 0.00000
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
