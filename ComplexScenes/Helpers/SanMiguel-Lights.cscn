// Lights

light "SunLight"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	illumination 10.0000
	shadow_producer true

	shadows
	{
		filter pcf
		global_illumination none

		raw_config
		{
			min_offset 0.0
			max_slope_offset 0.002
		}

		pcf_config
		{
			min_offset 0.0
			max_slope_offset 0.0005
		}

		vsm_config
		{
			min_variance 5.00000e-07
			light_bleeding_reduction 0.200000
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
