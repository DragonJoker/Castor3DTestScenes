// Lights

scene_node "LightNode"
{
	orientation 1 0 0 100
}

light "Light"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	illumination 10.0000

	shadows
	{
		producer true
		filter pcf
		global_illumination none
		volumetric_steps 20
		volumetric_scattering 0.9

		raw_config
		{
			min_offset 0.0001
			max_slope_offset 0.0001
		}

		pcf_config
		{
			min_offset 0.0001
			max_slope_offset 0.0001
		}

		vsm_config
		{
			min_variance 1.00000e-07
			light_bleeding_reduction 0.6
		}

		rsm_config
		{
			intensity 1.00000
			max_radius 0.0300000
			sample_count 20
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
