// Samplers

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "MRBlack"
{

	pass
	{
		albedo 0.00000 0.00000 0.00000
		roughness 1.00000
		metallic 0.00000
		two_sided true
		edge_width 1.00000
		edge_depth_factor 1.00000
		edge_normal_factor 1.00000
		edge_object_factor 1.00000
		edge_colour 0.00000 0.00000 0.00000 1.00000
	}
}

material "Material_#1004/affiche"
{

	pass
	{
		albedo 0.996078 0.996078 0.996078
		roughness 0.300000
		metallic 0.00000
		two_sided true
		edge_width 1.00000
		edge_depth_factor 1.00000
		edge_normal_factor 1.00000
		edge_object_factor 1.00000
		edge_colour 0.00000 0.00000 0.00000 1.00000

