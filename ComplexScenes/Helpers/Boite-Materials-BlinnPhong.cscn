// Samplers

sampler "TriLinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "baffles_boite/baffles"
{

	pass
	{
		diffuse 0.588235 0.588235 0.588235
		specular 0.0900000 0.0900000 0.0900000
		ambient 1.00000
		shininess 64.0000
		two_sided true

		texture_unit
		{
			sampler "TriLinear"
			levels_count 7
			image "Textures/BoiteLegacy/baffles.dds"
			diffuse_mask 0x00ffffff
			invert_y true
		}
	}
}

