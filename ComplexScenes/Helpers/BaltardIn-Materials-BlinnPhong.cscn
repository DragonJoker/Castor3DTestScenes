// Materials

material "baltard_in_ns/metal_cable"
{

	pass
	{
		lighting_model c3d.phong
		two_sided true
		colour_hdr 0.311180 0.311180 0.311180
		specular_colour 0.135000 0.135000 0.135000
		roughness 0.625000

		texture_unit
		{
			sampler "TriLinear"
			texture "spot_simple_metal"
		}
	}
}

