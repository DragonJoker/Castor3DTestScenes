// Samplers

sampler "TriLinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

// Materials

material "baltard_in_ns/armature"
{
	pass
	{
		diffuse 0.588235 0.588235 0.588235 0.00392157
		specular 0.486000 0.486000 0.486000 0.00392157
		shininess 128.0
		two_sided true
	}
}

