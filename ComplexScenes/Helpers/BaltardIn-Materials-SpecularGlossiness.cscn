// Materials

material "baltard_in_ns/metal_cable"
{

	pass
	{
		lighting_model c3d.pbr
		two_sided true
		colour_hdr 1.00000 1.00000 1.00000
		roughness 0.865000

		texture_unit
		{
			sampler "TriLinear"
			texture "spot_simple_metal"
		}
	}
}

