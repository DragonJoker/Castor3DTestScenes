			min_offset 0.0
			max_slope_offset 0.001
		}

		vsm_config
		{
			min_variance 1.00000e-06
			light_bleeding_reduction 0.0
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
