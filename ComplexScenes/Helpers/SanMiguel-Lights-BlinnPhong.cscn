// Lights

scene_node "LightNode"
{
	orientation 0.636294 -0.431266 0.63964 134.761
	// Orientation from sun on skybox
	// orientation 0.497314 0.68907 -0.527125 210.623
}

light "SunLight"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	intensity 4.00000 5.0000
	shadow_producer true

	shadows
	{
		filter pcf
		global_illumination lpv_geometry
		volumetric_steps 20
		volumetric_scattering 0.01

		raw_config
		{
			min_offset 0.0
			max_slope_offset 0.01
		}

		pcf_config
		{
			min_offset 0.0
			max_slope_offset 0.00001
		}

		vsm_config
		{
			variance_max 1.00000e-07
			variance_bias 0.200000
		}

		rsm_config
		{
			intensity 1.00000
			max_radius 0.0300000
			sample_count 100
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
