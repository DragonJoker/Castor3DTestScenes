// Lights

light "SunLight"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 1.00000
	illumination 5.00000

	shadows
	{
		filter pcf
		producer true
		global_illumination lpv_geometry
		volumetric_steps 20
		volumetric_scattering 0.0100000

		raw_config
		{
			min_offset 0.00000
			max_slope_offset 0.00200000
		}

		pcf_config
		{
			min_offset 0.00000
			max_slope_offset 0.00100000
			filter_size 4
			sample_count 8
		}

		vsm_config
		{
			min_variance 1.00000e-07
			light_bleeding_reduction 0.200000
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}
