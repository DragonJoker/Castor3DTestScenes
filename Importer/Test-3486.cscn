// Global configuration
materials pbr

scene "TransmissionTest"
{
	// Scene configuration
	ambient_light 1.0 1.0 1.0
	background_colour 1.00000 1.00000 1.00000

	//Skybox

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 2048
	}

	// Samplers

	sampler "Trilinear"
	{
		min_filter linear
		mag_filter linear
		mip_filter linear
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		lod_bias 0.00000
		border_colour float_opaque_black
		max_anisotropy 1.00000
	}

	//Lights

	scene_node "LightNode"
	{
		orientation 1 0 0 155.442
	}
	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 1.0 1.0
		intensity 0.8 1.0
	}

	//Cameras nodes

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 180
		position -0.0156659 0.0790437 1.4923
	}

	//Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"

		viewport
		{
			type perspective
			near 0.01
			far 100.00
			aspect_ratio 1.77800
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}

	import
	{
		file "Meshes/TransmissionTest/TransmissionTest.gltf"
	}
}

//Windows

window "MainWindow"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format argb32
		scene "TransmissionTest"
		camera "MainCamera"
		tone_mapping "linear"
	}
}
