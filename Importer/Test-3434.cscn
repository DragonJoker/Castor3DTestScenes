materials pbr

scene "Scene"
{
	ambient_light 1.0 1.0 1.0
	background_colour 0.5 0.5 0.5 1.0

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 2048 2048
	}

	sampler "TriLinear"
	{
		min_filter linear
		mag_filter linear
		mip_filter linear
		min_lod 0.0
		max_lod 5.0
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	material "Cerberus"
	{
		pass
		{
			albedo 0.75164 0.75164 0.75164
			roughness 0.1
			metalness 1.0
			two_sided true

			texture_unit
			{
				levels_count 6
				image "Textures/Cerberus/Cerberus_A.png"
				albedo_mask 0x00FFFFFF
				sampler	"TriLinear"
			}

			texture_unit
			{
				levels_count 6
				image "Textures/Cerberus/Cerberus_N.png"
				normal_mask 0x00FFFFFF
				sampler	"TriLinear"
			}

			texture_unit
			{
				levels_count 6
				image "Textures/Cerberus/Cerberus_M.png"
				metalness_mask 0x00FF0000
				sampler	"TriLinear"
			}

			texture_unit
			{
				levels_count 6
				image "Textures/Cerberus/Cerberus_R.png"
				roughness_mask 0x00FF0000
				sampler	"TriLinear"
			}

			texture_unit
			{
				levels_count 6
				image "Textures/Cerberus/Cerberus_AO.png"
				occlusion_mask 0x00FF0000
				sampler	"TriLinear"
			}
		}
	}

	scene_node "FinalNode"
	{
		position -2.25598e-06 0.0 93.7202
	}
	mesh "Mesh"
	{
		import "Meshes/Cerberus_LP.FBX"
		default_material "Cerberus"
	}
	object "FinalPrimitive"
	{
		parent "FinalNode"
		mesh "Mesh"
	}

	scene_node "MainCameraNode"
	{
		orientation 0.0681977 0.989363 -0.128492 124.591
		position -120.913 32.688 152.272
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			//aspect_ratio 1.778
			near 0.1
			far 20000.0
		}
	}
}

window "Window"
{
	render_target
	{
		size 800 600
		//size 1920 1080
		format argb32
		scene "Scene"
		camera "MainCamera"
	}
	fullscreen false
	vsync false
}
