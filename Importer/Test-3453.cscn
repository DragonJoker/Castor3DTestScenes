// Global configuration
materials pbr

scene "Scene"
{
	// Scene configuration
	ambient_light 1.00000 1.00000 1.00000
	background_colour 0.00000 0.00000 0.00000

	//Skybox

	skybox
	{
		equirectangular "Textures/backgroundSkyboxEquirectangularHdr.hdr" 1024
	}

	// Samplers

	sampler "Trilinear"
	{
		min_filter linear
		mag_filter linear
		mip_filter linear
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		lod_bias 0.00000
		border_colour float_opaque_black
		max_anisotropy 1.00000
	}

	//Cameras nodes

	scene_node "MainCameraNode"
	{
		orientation 0 1 0 180
		position 0.00000 1.00000 3.00000
	}

	//Cameras

	camera "MainCamera"
	{
		parent "MainCameraNode"

		viewport
		{
			type perspective
			near 0.100000
			far 1000.00
			aspect_ratio 1.77800
			fov_y 45.0000
		}

		hdr_config
		{
			exposure 1.00000
			gamma 2.20000
		}
	}

	import
	{
		file "Meshes/Izzy/scene.gltf"
		rescale 0.01
		texture_remap_config
		{
			specular
			{
				occlusion_mask 0x00FF0000
				roughness_mask 0x0000FF00
				metalness_mask 0x000000FF
			}
		}
	}

	//Animated object groups

	animated_object_group "scene-8_0"
	{
/*
		animated_object "gltf-Node-23-Bra_Bra_0-10"
		animated_object "gltf-Node-25-short_jeans_short_jeans_0-11"
		animated_object "gltf-Node-10-2-2"
		animated_object "gltf-Node-15-5-5"
		animated_object "gltf-Node-11-3-3"
		animated_object "gltf-Node-13-4-4"
		animated_object "gltf-Node-16-6-6"
		animated_object "gltf-Node-18-CC_Base_Eye_Eye_0-7"
		animated_object "gltf-Node-19-CC_Base_Eye_Cornea_0-8"
		animated_object "gltf-Node-21-Boots_Boots_0-9"
		animated_object "gltf-Node-27-RL_G6_Hair_low pony tail_0-12"
		animated_object "gltf-Node-8-0-0"
		animated_object "gltf-Node-9-1-1"
*/
		start_animation "walk0518"
	}
}

//Windows

window "MainWindow"
{
	vsync false
	fullscreen false

	render_target
	{
		size 1920 1080
		format argb32
		scene "Scene"
		camera "MainCamera"
		tone_mapping "aces"

		smaa
		{
			mode 1X
			preset ultra
			edgeDetection colour
			enablePredication true
			enableReprojection true
		}
	}
}
