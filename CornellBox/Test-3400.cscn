// debug_overlays true
materials blinn_phong

scene "CornellBox"
{
	ambient_light 0.0 0.0 0.0
	background_colour 0.0 0.0 0.0
	include "Materials/SphereMaterialsPhong.cscn"
	include "Meshes/SphereSpotMeshes.cscn"
	include "Helpers/SphereSpotNodes.cscn"
	include "Helpers/SphereObjects.cscn"
	include "Helpers/SphereSpotCamera.cscn"
	include "Helpers/SphereSpotLight-VSM.cscn"
}

window "Window"
{
	vsync false
	// fullscreen true

	render_target
	{
		// size 1280 720
		size 1920 1080
		format argb32
		scene "CornellBox"
		camera "MainCamera"

		ssao
		{
			enabled true
			high_quality true
			use_normals_buffer true
			blur_high_quality true
			intensity 1.0
			min_radius 0.1
			radius 0.5
			bias 0.025
			num_samples 23
			edge_sharpness 1.0
			blur_step_size 2
			blur_radius 4
			// bend_step_count 10
			// bend_step_size 0.5
		}
	}
}
