// Materials

material "Gltf-grooved-anisotropy"
{

	pass
	{

		lighting_model "c3d.pbr"
		{
			specular_brdf "anisotropic"
		}
		metalness 1.00000
		anisotropy_strength 1.00000
		anisotropy_rotation 91.6732

		texture_unit
		{
			sampler "NevLinLinLinURepVRepWRepFtb"
			texture "Image_2_2"

			transform
			{
				translate 6.00000 -1.00000 0.00000
				rotate -90.0000
				scale 6.00000 2.00000 1.00000
			}
		}

		texture_unit
		{
			sampler "NevLinLinLinURepVRepWRepFtb"
			texture "Image_1_1"
		}

		texture_unit
		{
			sampler "NevLinLinLinURepVRepWRepFtb"
			texture "Image_3_3"
		}
	}
}

