// Samplers

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	u_wrap_mode clamp_to_border
	v_wrap_mode clamp_to_border
	w_wrap_mode clamp_to_border
	min_lod 0.0
	max_lod 5.0
	max_anisotropy 5.0
	lod_bias 0.0
	border_colour float_opaque_black
}

// Materials

material "Body"
{
	pass
	{
		albedo 1.00000 1.00000 1.00000
		metalness 1.00000
		two_sided true
		alpha_func greater 0.5

		lighting_model "pbr"
		{
			diffuse_brdf "energy_conservative_oren_nayar"
			specular_brdf "cook_torrance"
		}

		texture_unit
		{
			sampler "Trilinear"
			albedo_mask 0x00FFFFFF
			image "Textures/Nyra/body-diffuse.jpg"
		}

		texture_unit
		{
			sampler "Trilinear"
			opacity_mask 0xFF000000
			image "Textures/Nyra/body-opacity.png"
		}

		texture_unit
		{
			sampler "Trilinear"
			normal_mask 0x00FFFFFF
			image "Textures/Nyra/body-normal.jpg"
		}

		texture_unit
		{
			sampler "Trilinear"
			metalness_mask 0x00FF0000
			image "Textures/Nyra/body-metallic.jpg"
		}

		texture_unit
		{
			sampler "Trilinear"
			roughness_mask 0x00FF0000
			image "Textures/Nyra/body-roughness.jpg"
		}

		texture_unit
		{
			sampler "Trilinear"
			height_mask 0x00FF0000
			image "Textures/Nyra/body-displ.png"
		}
	}
}

material "Cornea"
{
	pass
	{
		albedo 0.000000 0.000000 0.000000
		metalness 1.00000
		roughness 0
		alpha 0.119661
		two_sided true
		alpha_blend_mode interpolative
	}
}

material "Eyes"
