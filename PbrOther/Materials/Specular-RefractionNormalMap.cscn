ambient_light 0.5 0.5 0.5

sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	min_lod 0.0
	max_lod 5.0
	lod_bias 0.0
	u_wrap_mode clamp_to_border
	v_wrap_mode clamp_to_border
	w_wrap_mode clamp_to_border
	border_colour float_opaque_black
}

material "MatBody"
{
	pass
	{
		specular 1.0 1.0 1.0
		glossiness 1.0
		alpha_func greater 0.5
		refraction_ratio 2.42
		transmission 1.0
		attenuation_distance 1.0
		attenuation_colour 1.0 1.0 1.0
		thickness_factor 1.0

		texture_unit
		{
			opacity_mask 0xFF000000
			image "Textures/Nyra/body-opacity.png"
			sampler "Trilinear"
		}

		texture_unit
		{
			sampler "Trilinear"
			albedo_mask 0x00FFFFFF
			image "Textures/Nyra/body-diffuse.jpg"
		}

		texture_unit
		{
			normal_mask 0x00FFFFFF
			image "Textures/Nyra/body-normal.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			sampler "Trilinear"
			roughness_mask 0x00FF0000
			image "Textures/Nyra/body-roughness.jpg"
		}
	}
}

material "MatHead"
{
	pass
	{
		specular 1.0 1.0 1.0
		glossiness 1.0
		refraction_ratio 2.42
		transmission 1.0
		attenuation_distance 1.0
		attenuation_colour 1.0 1.0 1.0
		thickness_factor 1.0

		texture_unit
		{
			sampler "Trilinear"
			albedo_mask 0x00FFFFFF
			image "Textures/Nyra/head-diffuse.jpg"
		}

		texture_unit
		{
			normal_mask 0x00FFFFFF
			image "Textures/Nyra/head-normal.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			sampler "Trilinear"
			roughness_mask 0x00FF0000
			image "Textures/Nyra/head-roughness.jpg"
		}
	}
}

material "cornea"
{
	pass
	{
		specular 1.0 1.0 1.0
		glossiness 1.0
		refraction_ratio 2.42
		transmission 1.0
		attenuation_distance 1.0
		attenuation_colour 1.0 1.0 1.0
		thickness_factor 1.0
	}
}

material "dx11Shader6"
{
	pass
	{
		specular 1.0 1.0 1.0
		glossiness 1.0
		alpha_func greater 0.5
		refraction_ratio 2.42
		transmission 1.0
		attenuation_distance 1.0
		attenuation_colour 1.0 1.0 1.0
		thickness_factor 1.0

		texture_unit
		{
			sampler "Trilinear"
			albedo_mask 0x00FFFFFF
			image "Textures/Nyra/head-diffuse.jpg"
		}

		texture_unit
		{
			opacity_mask 0xFF000000
			levels_count 6
			image "Textures/Nyra/head-opacity.png"
			sampler "Trilinear"
		}

		texture_unit
		{
			normal_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/head-normal.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			sampler "Trilinear"
			roughness_mask 0x00FF0000
			image "Textures/Nyra/head-roughness.jpg"
		}
	}
}
