materials pbr
default_unit km

scene "Scene"
{
	ambient_light 0.2 0.2 0.2

	scene_node "LightNode"
	{
		orientation 1.0 0.0 0.0 65.0
	}

	scene_node "PlanetNode"
	{
		position 0.0 0.0 19000.0
	}

	atmospheric_scattering
	{
		sunNode "LightNode"
		planetNode "PlanetNode"
		transmittanceResolution 256 64
		multiScatterResolution 32
		atmosphereVolumeResolution 32
		skyViewResolution 192 108
		sunIlluminance 1.0 1.0 1.0
		sunIlluminanceScale 1.0
		rayMarchMinSPP 4
		rayMarchMaxSPP 14
		multipleScatteringFactor 1.0
		solarIrradiance 1.0 1.0 1.0
		sunAngularRadius 0.004675
		absorptionExtinction 0.000650 0.001881 0.000085
		maxSunZenithAngle 102.0
		rayleighScattering 0.005802 0.013558 0.033100
		mieScattering 0.003996 0.003996 0.003996
		miePhaseFunctionG 0.8
		mieExtinction 0.004440 0.004440 0.004440
		bottomRadius 6360.0
		topRadius 6460.0
		groundAlbedo 0.0 0.0 0.0

		minRayleighDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.0
			constantTerm 0.0
		}
		maxRayleighDensity
		{
			layerWidth 0.0
			expTerm 1.0
			expScale -0.125 // -1 / 8
			linearTerm 0.0
			constantTerm 0.0
		}

		minMieDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.0
			constantTerm 0.0
		}
		maxMieDensity
		{
			layerWidth 0.0
			expTerm 1.0
			expScale -0.83333 // -1 / 1.2
			linearTerm 0.0
			constantTerm 0.0
		}

		minAbsorptionDensity
		{
			layerWidth 25.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.066666 // 1 / 15
			constantTerm -0.66666 // -2 / 3
		}
		maxAbsorptionDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm -0.066666 // -1 / 15
			constantTerm 2.66666 // 8 / 3
		}

		clouds
		{
			coverage 0.0
		}
	}

	// Cameras

	scene_node "MainCameraNode"
	{
		position 0.0 0.0 6360.0
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.0
			near 1.0
			far 200000.0
		}
	}
}

window "Window"
{
	render_target
	{
		format argb32
		size 720 720
		scene "Scene"
		camera "MainCamera"
		// postfx "pbr_bloom"
	}
	fullscreen false
	vsync false
}
