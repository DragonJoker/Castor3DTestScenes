// Samplers

sampler "Linear"
{
	min_filter linear
	mag_filter linear
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

// Materials

material "Terrain"
{
	// Sand
	pass
	{
		albedo 1.0 0.8 0.3
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.9 0.7 0.2
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.2 0.2 0.2
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}

	// Grass
	pass
	{
		albedo 0.3 0.6 0.25
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.4 0.2 0.1
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.2 0.2 0.2
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}

	// Forest
	pass
	{
		albedo 0.2 0.4 0.2
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.3 0.1 0.05
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.2 0.2 0.2
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}

	// Snow
	pass
	{
		albedo 0.8 0.8 0.8
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.7 0.7 0.7
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
	pass
	{
		albedo 0.4 0.4 0.4
		emissive 0.0
		metalness 0.0
		roughness 1.0
	}
}
