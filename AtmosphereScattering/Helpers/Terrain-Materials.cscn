// Samplers

sampler "Linear"
{
	min_filter linear
	mag_filter linear
	lod_bias 0.0
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	border_colour float_opaque_black
}

// Materials

material "Terrain"
{
	// Sand
	pass
	{
		albedo 1.0 1.0 1.0
		emissive 0.0
		metalness 0.0
		roughness 1.0
		two_sided true
		untile true

		texture_unit
		{
			image "Textures/Sand/LowSteepness/ground_0024_color_2k.jpg"
			albedo_mask 0x00FFFFFF
			sampler	"Linear"
		}

		texture_unit
		{
			image "Textures/Sand/LowSteepness/ground_0024_normal_opengl_2k.png"
