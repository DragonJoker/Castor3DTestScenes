default_lighting_model "c3d.pbr"
{
	scattering_model "atmosphere_scattering"
}
scene "Scene"
{
	ambient_light 1.0 1.0 1.0
	background_colour 0.5 0.5 0.5

	scene_node "LightNode"
	{
		orientation -0.0151991 0.999078 -0.0401618 241.947
	}
	light "SunLight"
	{
		parent "LightNode"
		type directional
		colour 1.0 0.8 0.6
		illumination 10.0
	}

	scene_node "PlanetNode"
	{
		position 0.0 -6360000.0 0.0
	}

	atmospheric_scattering
	{
		sunNode "LightNode"
		planetNode "PlanetNode"
		transmittanceResolution 256 64
		multiScatterResolution 32
		atmosphereVolumeResolution 32
		skyViewResolution 192 108
		sunIlluminance 1.0 1.0 1.0
		sunIlluminanceScale 1.0
		rayMarchMinSPP 4
		rayMarchMaxSPP 14
		multipleScatteringFactor 1.0
		solarIrradiance 1.0 1.0 1.0
		sunAngularRadius 0.004675
		absorptionExtinction 0.000650 0.001881 0.000085
		maxSunZenithAngle 102.0
		rayleighScattering 0.005802 0.013558 0.033100
		mieScattering 0.003996 0.003996 0.003996
		miePhaseFunctionG 0.8
		mieExtinction 0.004440 0.004440 0.004440
		bottomRadius 6360.0
		topRadius 6460.0
		groundAlbedo 0.0 0.0 0.0

		minRayleighDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.0
			constantTerm 0.0
		}
		maxRayleighDensity
		{
			layerWidth 0.0
			expTerm 1.0
			expScale -0.125 // -1 / 8
			linearTerm 0.0
			constantTerm 0.0
		}

		minMieDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.0
			constantTerm 0.0
		}
		maxMieDensity
		{
			layerWidth 0.0
			expTerm 1.0
			expScale -0.83333 // -1 / 1.2
			linearTerm 0.0
			constantTerm 0.0
		}

		minAbsorptionDensity
		{
			layerWidth 25.0
			expTerm 0.0
			expScale 0.0
			linearTerm 0.066666 // 1 / 15
			constantTerm -0.66666 // -2 / 3
		}
		maxAbsorptionDensity
		{
			layerWidth 0.0
			expTerm 0.0
			expScale 0.0
			linearTerm -0.066666 // -1 / 15
			constantTerm 2.66666 // 8 / 3
		}

		clouds
		{
			coverage 0.0
		}
	}

	sampler "Linear"
	{
		min_filter linear
		mag_filter linear
		lod_bias 0.0
		u_wrap_mode repeat
		v_wrap_mode repeat
		w_wrap_mode repeat
		border_colour float_opaque_black
	}

	texture "BricksDif"
	{
		image "Textures/Bricks/Diffuse.jpg"
		albedo_mask 0x00FFFFFF
	}

	texture "BricksNml"
	{
		image "Textures/Bricks/Normal.jpg"
		normal_mask 0x00FFFFFF
	}

	texture "BricksRgh"
	{
		image "Textures/Bricks/Height.jpg"
		roughness_mask 0x00FF0000
	}

	material "FloorMaterial"
	{
		pass
		{
			albedo 1.0 1.0 1.0
			emissive 0.0
			metalness 0.0
			roughness 0.8

			texture_unit
			{
				texture "BricksDif"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksNml"
				sampler "Linear"
			}

			texture_unit
			{
				texture "BricksRgh"
				sampler "Linear"
			}
		}
	}
	mesh "FloorMesh"
	{
		type "plane" -width_subdiv=0 -depth_subdiv=0 -width=600 -depth=600
		default_material "FloorMaterial"
	}
	scene_node "FloorNode"
	{
		parent "PlanetNode"
		position 0.0 6360000.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}
	object "Floor"
	{
		parent "FloorNode"
		mesh "FloorMesh"
	}

	texture "WaterNormal1"
	{
		image "Textures/Waves/waterNM1.dds"
		water_normal1_mask 0x00FFFFFF
	}

	texture "WaterNormal2"
	{
		image "Textures/Waves/waterNM2.dds"
		water_normal2_mask 0x00FFFFFF
	}

	texture "WaterNoise"
	{
		image "Textures/Waves/waterNoise.dds"
		water_noise_mask 0x00FF0000
	}

	material "WaterMaterial"
	{
		pass
		{
			lighting_model "c3d.water"
			{
				scattering_model "atmosphere_scattering"
			}
			colour_srgb 0.003 0.599 0.812
			metalness 0.0
			roughness 0.08
			refraction_ratio 1.2
			dampeningFactor 5.0
			depthSofteningDistance 0.5
			refractionDistortionFactor 0.04
			refractionHeightFactor 2.5
			refractionDistanceFactor 0.05
			ssrStepSize 0.5
			ssrForwardStepsCount 20.0
			ssrBackwardStepsCount 10.0
			ssrDepthMult 20.0

			texture_unit
			{
				texture "WaterNormal1"
				sampler "Linear"
				animation
				{
					translate 0.01 0.0
				}
			}

			texture_unit
			{
				texture "WaterNormal2"
				sampler "Linear"
				animation
				{
					translate 0.0 0.01
				}
			}

			texture_unit
			{
				texture "WaterNoise"
				sampler "Linear"
			}
		}
	}
	mesh "WaterMesh"
	{
		type "plane" -width_subdiv=1000 -depth_subdiv=1000 -width=1000 -depth=1000
		default_material "WaterMaterial"
	}
	scene_node "WaterNode"
	{
		parent "PlanetNode"
		position 0.0 6360002.0 0.0
		orientation 1.0 0.0 0.0 270.0
	}
	object "Water"
	{
		parent "WaterNode"
		mesh "WaterMesh"
	}

	scene_node "MainCameraNode"
	{
		position -542.925 152.329 -372.367
		orientation 0.247141 0.960752 -0.126006 55.9081
	}
	camera "MainCamera"
	{
		parent "MainCameraNode"
		primitive triangle_list
		viewport "MainViewport"
		{
			type perspective
			fov_y 45.0
			aspect_ratio 1.333
			near 1.0
			far 20000.0
		}
	}
}

window "Window"
{
	fullscreen false
	vsync false

	render_target
	{
		format argb32
		size 800 600
		scene "Scene"
		camera "MainCamera"
	}
}
