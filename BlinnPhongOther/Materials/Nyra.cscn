			levels_count 6
			image "Textures/Nyra/head-specular.jpg"
			sampler "Trilinear"
		}
	}
}

material "cornea"
{
	pass
	{
		diffuse 0.000000 0.000000 0.000000
		specular 1.00000 1.00000 1.00000
		shininess 128.0
		alpha 0.00392157
		two_sided true
		alpha_blend_mode interpolative
	}
}

