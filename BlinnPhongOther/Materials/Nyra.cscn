sampler "Trilinear"
{
	min_filter linear
	mag_filter linear
	mip_filter linear
	min_lod 0.0
	max_lod 5.0
	lod_bias 0.0
	u_wrap_mode clamp_to_border
	v_wrap_mode clamp_to_border
	w_wrap_mode clamp_to_border
	border_colour float_opaque_black
}

material "MatBody"
{
	pass
	{
		shininess 128.0
		alpha 1.0
		alpha_func greater 0.5
		two_sided true

		texture_unit
		{
			diffuse_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/body-diffuse.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			opacity_mask 0xFF000000
			levels_count 6
			image "Textures/Nyra/body-opacity.png"
			sampler "Trilinear"
		}

		texture_unit
		{
			normal_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/body-normal.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			specular_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/body-specular.jpg"
			sampler "Trilinear"
		}
	}
}

material "MatHead"
{
	pass
	{
		shininess 128.0
		two_sided true

		texture_unit
		{
			diffuse_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/head-diffuse.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
			normal_mask 0x00FFFFFF
			levels_count 6
			image "Textures/Nyra/head-normal.jpg"
			sampler "Trilinear"
		}

		texture_unit
		{
