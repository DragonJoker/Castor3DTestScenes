// Samplers

sampler "Default"
{
	min_filter linear
	mag_filter linear
	mip_filter nearest
	u_wrap_mode repeat
	v_wrap_mode repeat
	w_wrap_mode repeat
	min_lod -1000.00
	max_lod 1000.00
	lod_bias 0.00000
	border_colour float_opaque_black
	max_anisotropy 1.00000
}

// Materials

material "Imp-Antenna_Metal"
{

	pass
	{
		albedo 1.00000 1.00000 1.00000
		specular 0.500000 0.500000 0.500000
		glossiness 0.100000
		two_sided true

		texture_unit
		{
			levels_count 8
			image "../Data/Textures/Bistro/Metal_Clean_01_diff.dds"
			albedo_mask 0x00ffffff
			invert_y true
		}

		texture_unit
		{
			levels_count 8
			image "../Data/Textures/Bistro/Metal_Clean_01_spec.dds"
			specular_mask 0x00ffffff
			invert_y true
		}
	}
}

