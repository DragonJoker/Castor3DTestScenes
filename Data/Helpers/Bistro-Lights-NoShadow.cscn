// Lights

scene_node "LightNode"
{
	orientation -0.71521 0.380994 -0.585934 236.489
}

light "SunLight"
{
	parent "LightNode"
	type directional
	colour 1.00000 1.00000 0.8.00000
	illumination 10.0000

	shadows
	{
		producer true
		filter pcf
		global_illumination none

		raw_config
		{
			min_offset 0.0
			max_slope_offset 0.0002
		}

		pcf_config
		{
			min_offset 0.0
			max_slope_offset 0.0002
		}

		vsm_config
		{
			min_variance 1.00000e-07
			light_bleeding_reduction 0.00000
		}

		rsm_config
		{
			intensity 0.00000
			max_radius 0.00000
			sample_count 100
		}

		lpv_config
		{
			texel_area_modifier 1.00000
		}
	}
}

